ull,"https://play-lh.googleusercontent.com/AZItOP7GTOgKg0hvkNq5P9TsPewKZfq1YRpglrnML7K1CprJr8wZYj66bmi6YeiTbOu8woFdvY_pcXFgL6qB9S4"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/AHOcL7kF_n4mvSk6ZwvTd6mEHorVD3JCYGLcUEE4g6zRRhozW6xOzB_SeXQoOsIq62W4rUB3sZs487sAMkjbLw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/q50FxT3SlQywy7ITJkI_NpodKRO-zh37ZqQTYh_ZrUacVarYJORjivkgsH4eR9M2WkBmpHGRKq7chh4CnE5FLCA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/BJhVC1-_V0QAUwhhqDNK15fxPmr_p0InUSA4xK3MV6Sc8qLu8LSxeV1HdNtT_4iMbrvJOKDJp8XCArfTiv1sog"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/ZCc9LBA0nsDBnJQJEBvWVBjFVpC-FwwP8zWdStI5dbStyFz0dya2QVHhWzw7Rhm1ZGkh2rpMGqT7goWVi5zsKQ"]]],"BanG Dream! Our Notes",["4.2",4.2460318],"Music",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.bilibili.sirius\u0026rdid\u003dcom.bilibili.sirius\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.bilibili.sirius"]],["\u003d\u003d"],null,[null,"Presenting BanG Dream! Our Notes, a brand-new rhythm game adventure from BanG Dream! Project!\u003cbr\u003e\u003cbr\u003eEnjoy a wide variety of songs from five bands and discover a rich new story waiting to unfold.\u003cbr\u003e\u003cbr\u003e◆New Rhythm Game System: “GEKISO LIVE”◆\u003cbr\u003eSpecial GEKISO sections will now appear during rhythm gameplay!\u003cbr\u003eCombos, timing precision, and even luck—put your rhythm game skills to the ultimate challenge in an exciting new gameplay experience!\u003cbr\u003eFeel the excitement and immersion of a real BanG Dream! live performance and enjoy the party-style rhythm gameplay with up to five players!\u003cbr\u003e\u003cbr\u003eOur Notes also features an exclusive new system: Assist Mode!\u003cbr\u003eWhether you\u0026#39;re new to rhythm games or just looking for a more relaxed experience, Assist Mode lets everyone enjoy the performance and improve at their own pace.\u003cbr\u003e\u003cbr\u003e◆From Original Songs to the Latest Hit Covers◆\u003cbr\u003eFrom iconic original songs featured in the BanG Dream! anime—including tracks by MyGO!!!!! and Ave Mujica—to a wide range of popular cover songs, the lineup is packed with music to enjoy!\u003cbr\u003ePlay your favorite songs, from the latest hits to beloved classics.\u003cbr\u003eYou can also watch a variety of performance scenes and music videos from the BanG Dream! anime series.\u003cbr\u003ePlus, the latest tracks from fan-favorite bands MyGO!!!!! and Ave Mujica will be available first in Our Notes!\u003cbr\u003e\u003cbr\u003e【BanG Dream! Songs】\u003cbr\u003e・Mayoiuta / MyGO!!!!!\u003cbr\u003e・KiLLKiSS / Ave Mujica\u003cbr\u003e・Haruhikage (MyGO!!!!! ver.) / MyGO!!!!!\u003cbr\u003e・MUGEN MY WORLD / Mugendai MewType\u003cbr\u003e・Kishi Kaisen / millsage\u003cbr\u003e・Homie’s Tie!! / Ikka Dumb Rock!\u003cbr\u003e...and many more\u003cbr\u003e\u003cbr\u003eMore cover songs will be coming up soon!\u003cbr\u003e\u003cbr\u003e◆New Stories Woven by Five Bands◆\u003cbr\u003eAlongside MyGO!!!!!, Ave Mujica, and Mugendai MewType, millsage and Ikka Dumb Rock! also join the stage!\u003cbr\u003eWith the Cinematic Story System, characters move vividly with rich expressions, just like in a movie or anime.\u003cbr\u003eSpecial scenes also feature animated sequences, including all-new cuts.\u003cbr\u003eA wide range of visual effects and illustrated scenes come together to deliver a spectacularly renewed story experience.\u003cbr\u003e\u003cbr\u003eRelive the familiar anime stories of MyGO!!!!!, Ave Mujica, and Mugendai MewType from the game-exclusive perspective. You can also enjoy special episodes that continue the anime stories, available exclusively in Our Notes. Meanwhile, millsage and Ikka Dumb Rock! will unfold completely original stories from the very beginning.\u003cbr\u003e\u003cbr\u003eExperience vibrant stories woven by five distinctive bands and a total of 25 unique members.\u003cbr\u003e\u003cbr\u003e◆Official Website◆\u003cbr\u003ehttps://bdon.biligames.com/?lang\u003den-us\u003cbr\u003e\u003cbr\u003e©BanG Dream! Project ©FROMTOKYO ©Bushiroad. Published by BILIBILI HK LIMITED"],"BILIBILI","100,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/mGjwNs4hC4PkO2UbIrUernKpX4QbvOHcbQIjNX6uvoAmhvzqlvbRr_dLyDWBYT6LubNcylleI5XdRvyV-xd5jA"],null,[252,252,252,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],null,[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.bilibili.sirius\u0026rdid\u003dcom.bilibili.sirius\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 15.000 - Rp 1.090.000 per item",[0]],{"101":[null,[[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/q50FxT3SlQywy7ITJkI_NpodKRO-zh37ZqQTYh_ZrUacVarYJORjivkgsH4eR9M2WkBmpHGRKq7chh4CnE5FLCA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/BJhVC1-_V0QAUwhhqDNK15fxPmr_p0InUSA4xK3MV6Sc8qLu8LSxeV1HdNtT_4iMbrvJOKDJp8XCArfTiv1sog"]],[null,2,[1080,1920],[null,null,"http