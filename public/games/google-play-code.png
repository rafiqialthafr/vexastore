: Grand Gourmet",["4.9",4.9],"Simulation",null,null,[null,[[209000000000,"IDR","Rp 209.000"]],null,[null,"Buy"],null,2,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.bandainamcoent.op_restaurant\u0026rdid\u003dcom.bandainamcoent.op_restaurant\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.bandainamcoent.op_restaurant"]],["\u003d\u003d"],[[[null,null,"eW3S1bK0sys",[null,null,"https://www.youtube.com/embed/eW3S1bK0sys?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:eW3S1bK0sys",null,null,null,null,"AXH1ezmeCLFvGnVOjUQB0IEdMsBSnJDMYN3irlI24nU1Oyv_TOKZFk9co0qlQQ-jTopKkv1lwtzZdjitghQTmGj5LHG58USNmsVGRlqHQfC1raxXD5x6TzH19n9p2tDft7VtMemhc0mRAiy4uN12zZN_zAKWJ0OjRbxvqbPZGxl6zH4SnN71Kj8dnnfMtKa4jq6kBhKwlZmYkXaFxcPqVk_8qmeevBzuIJmTzTyE-qhUE3niPTY23sy3R0gwq7ikvWBcNjeHsBABy1P2LOQa8xcLIsjGj5O5POPVhBJur3pXWfE\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/eW3S1bK0sys/hqdefault.jpg"]]]],[null,"ONE PIECE comes to life as a restaurant management sim game!\u003cbr\u003e\u003cbr\u003eAs a new staff member, work alongside the Straw Hat Crew to turn the second location of the renowned Baratie floating restaurant into the greatest restaurant of the seas!\u003cbr\u003e\u003cbr\u003e-Dish Out a Signature Menu\u003cbr\u003eGet inspired by characters\u0026#39; ideas, choose your ingredients, and work with Sanji to cook delicious dishes. Arrange them into unique meal sets by adding different flourishes, then adventure to find even more recipes! From iconic series favorites like Water-Water Meat BBQ and Sea King Penne Gorgonzola to special creations that harness the powers of Devil Fruits, a treasure trove of dishes awaits.\u003cbr\u003e\u003cbr\u003e-Design A Tasteful Interior\u003cbr\u003eChoose from over 200 furniture, building, and decorative items to make your restaurant uniquely yours! From dessert-themed Whole Cake Island pieces to futuristic Egghead items, the customization options are as vast as the sea. If a character likes your design, they may even become a regular!\u003cbr\u003e\u003cbr\u003e-Table for 400\u003cbr\u003eFrom the Straw Hat Crew and beyond, over 400 ONE PIECE characters appear as staff and customers in a spritely pixel style for the first time in a game! With so many characters, you\u0026#39;ll experience character events and special character interactions that can’t be found anywhere else.\u003cbr\u003eBandai Namco Entertainment Inc. Website:\u003cbr\u003ehttps://bandainamcoent.co.jp/english/\u003cbr\u003e\u003cbr\u003eSUPPORT:\u003cbr\u003ehttps://bnfaq.channel.or.jp/title/3388\u003cbr\u003e\u003cbr\u003eBandai Namco Entertainment Inc. Website:\u003cbr\u003ehttps://bandainamcoent.co.jp/english/\u003cbr\u003e\u003cbr\u003eBy downloading or installing this app, you agree to the Bandai Namco Entertainment Terms of Service.\u003cbr\u003e\u003cbr\u003eTerms of Service:\u003cbr\u003ehttps://legal.bandainamcoent.co.jp/terms/\u003cbr\u003ePrivacy Policy:\u003cbr\u003ehttps://legal.bandainamcoent.co.jp/privacy/\u003cbr\u003e\u003cbr\u003eThis application is distributed under the official rights from the license holder.\u003cbr\u003e\u003cbr\u003e©Eiichiro Oda/Shueisha, Toei Animation\u003cbr\u003e©Bandai Namco Entertainment Inc.\u003cbr\u003eDeveloped by Kairosoft"],"Bandai Namco Entertainment Inc.","5,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/9fBLB-ig4HvnoIXIT4C7hriN8arde5x2_0vdqSYpi3EmiQNgBLnwlvESoILBJTnZ0fmBjPTgo7vilKojC6TzxA"],null,[93,200,254,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,[null,"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted."],[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[209000000000,"IDR","Rp 209.000"]],null,[null,"Buy"],null,2,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.bandainamcoent.op_restaurant\u0026rdid\u003dcom.bandainamcoent.op_restaurant\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Rp 209.000 Buy"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],{"101":[null,[[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/jBxwtxQdrAfiPqX5jxLC6OEaYJhH3N_htcX2JfsrFMe8nTSjYgGWFMs2O1SsTBRWYxxkjkEnQpurgVOOswk7"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/SXeeO8cPFnXKuOzu5BMhMfkJ4tYxZFA0vfYhwOshPGN7OdFUHcKYTttn6znOp-HQJyWGJrlf4eA8e2-SKsq3sw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/bo_uWQIruT1CQxfVQUmKr62teWXko3gyStvp46d02Ms27bqJIzJHXScW6FmlbJgGzej1HhBDizS0zdve5d1K"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/4G32-Yxx53PCqfN7kP8-bC84n9vkUZa_rK9EORbda0mB3wwRsK67oVA1uIbPh7O5WQe-SCQKcsyPLEMNruJBVA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/M1anoR8C8XbTl7_NTCfh0IsCadNDvnrTDdv9VPrcNDeXvam2Ap3VmeWzBuJ_bpG71GauQk-kU4giYwnm0lY3"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/5iuxFxNqES-Y5ynvCJCtD5R-3oYMOndhhD1Y7XZEK7EuGCVL3A93DX079JHXX2fiOD0VVUkTteWvx5Camtun_g"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/Vs2b_vPRrXit81gjPLHFWmQOGLnRkgEBM8gqA23pxF5KF4n-E0ZxO_vQxz7eQDLgfjlfBYOzUStN0ukcHzx8lA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/SN3qVge87ymu59Crs