zf4sj-xK1oQfflEfeGV8_eHVeurzs1A3hQpkrz6pU_QQNtDI"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/IeHXsRwAZuK80X1D3uZegiCKMzMUy7-eMB3JcGmO1zrlGf9YouLsAOkozuqdhqLRkYMllu06gHq-bAr689okq6c"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/j1HRSZkXv-b1vm6QtpODYNbqoT8LbXnPK9WV6dDssFdGgqz_QI9v3qf30JRA5ctdOk3OvH1xaCNl2uFtRggbOf8"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/R85O410Ko4eoo1zm4jDsUQjBovhDo2YVSIsrrO1z_4d7bvncxScso11h9cnVRuXXZMcRrNvpkRFku_kUbUbxuxw"]]],"Top War: Battle Game",["4.7",4.709264],"Strategy",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.topwar.gp\u0026rdid\u003dcom.topwar.gp\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.topwar.gp"]],["\u003d"],null,[null,"Commander, the Dark Legion is coming! \u003cbr\u003e\u003cbr\u003eThese Tyrants rule the world! Constant war, refugees scattered across the land and a world starved of hope. Who will liberate us? Become the strongest Commander and a fearless leader in the struggle against the legion, right alongside the freedom league! Merge to upgrade your power whether it\u0026#39;s buildings, skills or units, if you can merge it, you can upgrade it! \u003cbr\u003e\u003cbr\u003e- FEATURES -\u003cbr\u003e\u003cbr\u003eTop War is an innovative strategy game featuring merge to upgrade gameplay, no more long upgrade waiting times, just merge two together and the upgrade will finish instantly! Recruit Legendary Heroes to lead the stationed Land, Navy and Airforce troops to victory! Upgrade heroes and troops with unique skills and equipment to lead all three armies to become immortal! \u003cbr\u003e\u003cbr\u003eStart on a barren, deserted island and build an idyllic base to train your armies, improve your power and liberate the land. Strength doesn\u0026#39;t come from just troops, and that\u0026#39;s a good thing! Create a stylish yet formidable island with a variety of buildings and decorations at your disposal. Come and show-off your unique style! \u003cbr\u003e\u003cbr\u003eBattle online with players from all over the world in a variety of game modes such as; Server v Server wars, Dark Forces, War Robots and weekly Capital Throne Showdowns all while experiencing the real battles with your alliance. Fight for glory, liberate the oppressed and dominate your enemies!\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e- PLEASE NOTE -\u003cbr\u003e\u003cbr\u003eTop War: Battle Game is free-to-play, however, some game items can also be purchased for real money (including random items). Playing requires a network connection.\u003cbr\u003e\u003cbr\u003e- FOLLOW US -\u003cbr\u003e\u003cbr\u003eFacebook: https://www.facebook.com/Topwarbattlegame/\u003cbr\u003eDiscord: https://discord.gg/topwarbattlegameofficial"],"RiverGame","50,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/9xjX32m2mEwUuXmXTxwuQMPRQO99zwDLFrZY6ZLrsbFH5OgOhP1JHnaDtN01dje9jcs7nG9p0PLXPOUoPPW6"],null,[226,237,239,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],null,[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.topwar.gp\u0026rdid\u003dcom.topwar.gp\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 16.000 - Rp 1.599.000 per item",[0]],{"101":[null,[[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/IeHXsRwAZuK80X1D3uZegiCKMzMUy7-eMB3JcGmO1zrlGf9YouLsAOkozuqdhqLRkYMllu06gHq-bAr689okq6c"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/j1HRSZkXv-b1vm6QtpODYNbqoT8LbXnPK9WV6dDssFdGgqz_QI9v3qf30JRA5ctdOk3OvH1xaCNl2uFtRggbOf8"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/R85O410Ko4eoo1zm4jDsUQjBovhDo2YVSIsrrO1z_4d7bvncxScso11h9cnVRuXXZMcRrNvpkRFku_kUbUbxuxw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/3zH4kg5aDJT5sMj8Esj0NnE3IVUEdzFP_X-2Kpow66Epg75KcMhzT553J19wbupPhQVGm6UOGKIz_iE91d6W4W0"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/4gYGokV7MJXW1V-M6mEIDgtSc-kD5AFHZoBNzf4sj-xK1oQfflEfeGV8_eHVeurzs1A3hQpkrz6pU_QQNtDI"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/IeHXsRwAZuK80X1D3uZegiCKMzMUy7-eMB3JcGmO1zrlGf9YouLsAOkozuqdhqLRkYMllu06gHq-bAr689okq6c"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/j1HRSZkXv-b1vm6QtpODYNbqoT8LbXnPK9WV6dDssFdGgqz_QI9v3qf30JRA5ctdOk3OvH1xaCNl2uFtRggbOf8"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/R85O410Ko4eoo1zm4jDsUQjBovhDo2YVSIsrrO1z_4d7bvncxScso11h9cnVRuXXZMcRrNvpkRFku_kUbUbxuxw"]]]]}],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,["Strategy"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]]],[[["com.HoYoverse.hkrpgoversea",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/aWrGocSA7hEuk1qAPe7L4T57LvLKrwwH26cK2_LOqxRQMQX7j3uHYojC-EKWgYEV2PdrmE0ahqvvhLh