,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.gurupuzzle.find.go.hidden.objects\u0026rdid\u003dcom.gurupuzzle.find.go.hidden.objects\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.gurupuzzle.find.go.hidden.objects"]],["CCGqAoYBGoMBCARKEwjti9efpNeXAxVfu6wCHQwyLgiyBGkKZQorCiVjb20uZ3VydXB1enpsZS5maW5kLmdvLmhpZGRlbi5vYmplY3RzEAEYAxIZChM0ODMyMzI0OTM1OTA5MTY0OTE5EFEYAxgDIAIo4Jyw95M0MIDmo7uZNEABSAFaAggBgAECMAg\u003d"],null,[null,"\u003cb\u003e🔥 Get ready for a FREE seek and find adventure in Hidden Objects Game: Find \u0026amp; Go! 🔍\u003c/b\u003e\u003cbr\u003e\u003cbr\u003e😌 Find \u0026amp; Go is a relaxing yet exciting hidden object game where every level turns into a playful scavenger hunt. Look closely, find hidden objects, and enjoy relaxing search puzzles. ✨\u003cbr\u003e\u003cbr\u003e🤔 If you love hidden object games, hide and seek challenges, or finding games, Find \u0026amp; Go will give you a fresh world full of cute details, tricky spots, and satisfying discoveries. From simple gardens 🌻 to busy streets 🐶 packed with surprises, every hidden level invites you to find it out and uncover what is hiding in plain sight.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eHow to Play This Finding Game\u003c/b\u003e\u003cbr\u003e👀 Check the object list before your scavenger hunt begins.\u003cbr\u003e🔎 Search the scene carefully from corner to corner.\u003cbr\u003e👉 Spot the right object once you find it out.\u003cbr\u003e🧩 Zoom in to inspect tiny details and tricky areas.\u003cbr\u003e💡 Use hints to locate the hidden item when you get stuck.\u003cbr\u003e🌟 Find every object to complete the search level and move on.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eWhy You Will Love Our Find Object Games\u003c/b\u003e\u003cbr\u003e\u003cbr\u003e🔮 Addictive Hidden Object Gameplay\u003cbr\u003eEnjoy classic seek and find fun with a casual twist. Each level is filled with hidden objects waiting to be found, from obvious items to clever little surprises. The gameplay is easy to understand, but every scene gives your eyes a fun challenge as you search, spot, and discover more.\u003cbr\u003e\u003cbr\u003e🎈 Difficulty That Grows With You\u003cbr\u003eFind \u0026amp; Go keeps every hidden puzzle fresh by adjusting the number of objects based on search level difficulty. Easier levels usually include about 30 hidden objects, while harder levels can challenge you to find 40 to 60 items. This makes each stage feel different, rewarding, and full of satisfying progress.\u003cbr\u003e\u003cbr\u003e🏝️ Colorful Scenes Full of Details\u003cbr\u003eStep into all kinds of creative scenes, from a fairy-tale bookroom and busy city streets to a warm bedroom, lively festival moments, and a pet-friendly garden. Each world feels different, colorful, and full of imagination, giving every search puzzle a fresh mood and a new place to find and discover.\u003cbr\u003e\u003cbr\u003e🌈 Relaxing Yet Engaging Puzzle Time\u003cbr\u003eFind \u0026amp; Go is perfect for a calm break, a quick puzzle session, or longer relaxing play. Simple rules make it easy for anyone to start, while changing object counts and detailed scenes keep every search satisfying. Take your time, spot hidden objects at your own rhythm, and enjoy pure finding fun with no pressure.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eFrequently Asked Questions (FAQ)\u003c/b\u003e\u003cbr\u003e\u003cbr\u003eQ: What type of game is Find \u0026amp; Go?\u003cbr\u003eA: Find \u0026amp; Go is a hidden object game, also known as a seek and find game or find objects game. Players search detailed scenes, spot hidden objects, and complete each hidden puzzle by finding every required item.\u003cbr\u003e\u003cbr\u003eQ: What kind of players is Find \u0026amp; Go suitable for?\u003cbr\u003eA: It is great for players who enjoy finding games, scavenger hunt fun, and relaxing visual puzzles. Whether you are a beginner or a hidden object expert, you will love every search in Find \u0026amp; Go!\u003cbr\u003e\u003cbr\u003eStart your search adventure in Find \u0026amp; Go and enjoy the fun of finding hidden objects one scene at a time. 🌟🎉\u003cbr\u003e\u003cbr\u003ePrivacy Policy: https://findandgo.gurugame.ai/policy.html\u003cbr\u003eTerms of Service: https://findandgo.gurugame.ai/termsofservice.html"],"Guru Puzzle Game","500,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/4v31-t4tHa4JqLjh0p-CPJN-TKhYKH-Y0MPG_W_cFxoijcUXYdJz4A3K4vNtfixHg9yZUPnvGubLHj2Xk6vVrA"],null,[245,229,210,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,[null,"In-Game Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.gurupuzzle.find.go.hidden.objects\u0026rdid\u003dcom.gurupuzzle.find.go.hidden.objects\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 35.000 - Rp 1.690.000 per item",[0]]],[[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.gurupuzzle.find.go.hidden.objects"]],["CCGqAoYBGoMBCARKEwjti9efpNeXAxVfu6wCHQwyLgiyBGkKZQorCiVjb20uZ3VydXB1enpsZS5maW5kLmdvLmhpZGRlbi5vYmplY3RzEAEYAxIZChM0ODMyMzI0OTM1OTA5MTY0OTE5EFEYAxgDIAIo4Jyw95M0MIDmo7uZNEABSAFaAggBgAECMAg\u003d"],[[null,[[0