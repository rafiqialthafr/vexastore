ontent.com/4zAT73G-be754YPNd0a0bYbFKIWWk_7Fo-HMaJiKLmbTI-XKfrdtKZVwPXe1_xeeyLxyRDHCPZRpTxW4zJYh"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/_ZFyITfmtBC9jGNMA93fNdMyAOQQVuLROD1c9e9KUpk4o__dgos7gWH1E-V7WKYnyZNvQlctPWIkTUtFb63V"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/D9XWSNFflG97crXcLZbPsEDJ2LqDAEzqtVDzxQr6guaLlYYCXvb1Ak7TITuEVNWDlwwXLZCYJD0IqEn7EPbr0xs"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/Ms86EVvYN425qdbMdB6QXt4mQGOf9bk-3Y7JmPb5QAfhWqvljY4TVGw_ho_ntiq3u_Z1kKDRp9Z9aZco6_ok3w"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/kL9cMydSMentv6vneQTsAvvFLbIIAZZsjFqAss1C2zIOCeq_moAtqsMvyHA2YVy08V8rESUmuigmSB2wN4mD"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/2PRXgQnWsMai6ZA0D9azQTwBuRXHwCCcwP4rC3yXW_hc_I34axejYP-LLh7eOcUv_zI9URJIR3cDWC8AQoJm"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/4MAhkHzSkFwXhYJvnuh8KE82Qj7cJIFDyeiw6Vr6hCUEvUn57j-Q9_En7_U0hs7QO5jy6IxaU8HRAQ7sq-UE"]],[null,2,[2048,1536],[null,null,"https://play-lh.googleusercontent.com/ma7bvhPn3obcCeyLkkh-vPjohtfPAZU4ZPzm7Dn-aRtwZqitF8LRnhbGlwxK3Hu796dZC07so0FC2XvG1pmj"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/4zAT73G-be754YPNd0a0bYbFKIWWk_7Fo-HMaJiKLmbTI-XKfrdtKZVwPXe1_xeeyLxyRDHCPZRpTxW4zJYh"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/_ZFyITfmtBC9jGNMA93fNdMyAOQQVuLROD1c9e9KUpk4o__dgos7gWH1E-V7WKYnyZNvQlctPWIkTUtFb63V"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/D9XWSNFflG97crXcLZbPsEDJ2LqDAEzqtVDzxQr6guaLlYYCXvb1Ak7TITuEVNWDlwwXLZCYJD0IqEn7EPbr0xs"]]],"Showa Candy Shop Neo",["4.7",4.6666665],"Puzzle",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003djp.co.gagex.ankaa\u0026rdid\u003djp.co.gagex.ankaa\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003djp.co.gagex.ankaa"]],[""],[[[null,null,"aoa-ZC0yt0w",[null,null,"https://www.youtube.com/embed/aoa-ZC0yt0w?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:aoa-ZC0yt0w",null,null,null,null,"AXH1ezmjtIKDljsfK9nDLBWO6CWp97DI20NAlGchVPuXgXRnL-FZRFga2wGlNue0u1ychxUTVTm4dXe6BDhIAlAIa2zvavpqcaOiu4GhUilnQrVu4DtSfROkZxam-_4aAD3DBG34XuC2l6dtjXhezKtzBSP8wckpbYfN1pOQbjzvFVfRQz-aUFi4saRX48JM-_SXyNbNtDvkDnDbr9_Ue8786Kj7jHCdwNDUUcTo1M8KfuElPbdHMZBBTJdt4ha-KpaKrqdCqVkLtP-ApRnh0xEHjbnz9FSHcsnIIpxBO3O9zxQ\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/aoa-ZC0yt0w/hqdefault.jpg"]]]],[null,"Puzzles That Will Stay With You\u003cbr\u003eWe’ve all got something we’re nostalgic for. A time. A place. A face.\u003cbr\u003e\u003cbr\u003eGagex is back once again, and this time we’re switching up genres for a light-hearted puzzle take on the candy stores of the Showa Era. That\u0026#39;s right, the Showa Candy Shop series returns, and this time with a brain-teasing twist!\u003cbr\u003eSolve delightfully challenging match-3 puzzles to expand Grandma’s candy shop—it’s a new wrinkle that’s sure to excite longtime fans while keeping things approachable for new players. You won’t be able to put these puzzles down, and that\u0026#39;s all for the best, because a shocking story conclusion awaits you once you complete all 1,000 puzzles!\u003cbr\u003e\u003cbr\u003eBut puzzles aren\u0026#39;t all there is to this tasty little candy shop—there\u0026#39;s also a bevy of goodies you can collect that\u0026#39;ll be sure to give you glimpses of what Japan was like back in the day, or create knee-slapping, “I remember that!” moments for anyone who lived it.\u003cbr\u003e\u003cbr\u003eOh, and of course there’s still a big cast of quirky characters you\u0026#39;ll meet along the way, and their stories will unravel a brand-new heartwarming tale!\u003cbr\u003e\u003cbr\u003eGet ready to lose yourself in this candy shop!\u003cbr\u003e\u003cbr\u003eStory\u003cbr\u003eRemember those summer days long gone by, when the world was your oyster? When every day held the possibility of a trip to the hallowed halls of the candy store?\u003cbr\u003e\u003cbr\u003eWay down a little side street off the main drag, in a tiny piece of Tokyo no one’s ever heard of, sits a small candy shop bursting with candies of yore.\u003cbr\u003e\u003cbr\u003eGrandma watches over this modest shop, a veritable paradise for the local kids, all by herself.\u003cbr\u003e\u003cbr\u003eCome on in! Oh, and while you’re here, would you mind picking up a shift or two for Grandma? She looks half-asleep already!\u003cbr\u003e\u003cbr\u003eBesides, there\u0026#39;s a funny feeling in the air... Almost like some strange, heartfelt tale is about to unfold here amongst the penny candies and tasty treats...\u003cbr\u003e\u003cbr\u003eDesigned for Relaxed Play\u003cbr\u003e-See the story through!\u003cbr\u003eClear all 1,000 stages to see how the story ends.\u003cbr\u003e...You read that right: this game has an ending!\u003cbr\u003eNo endless mobile live-service game treadmills here! \u003cbr\u003e\u003cbr\u003eYou can only play a little bit each day? No problem! Play at your own pace. You’re in no danger of this game shutting down before you can finish it!\u003cbr\u003e\u003cbr\u003e-Puzzles and a good story. What more do you need?\u003cbr\u003eThere aren’t any social elements in here, either. That means no limited-time events and no sweaty leaderboards. Just a bunch of thoughtfully-designed puzzles and a heartfelt story for you to dive into.\u003cbr\u003e\u003cbr\u003e-It’s free to play!\u003cbr\u003eYou can play to the end without spending a thing!\u003cbr\u003e(Though there are items you can buy if you so choose!)\u003cbr\u003e\u003cbr\u003ePacked with Puzzles!\u003cbr\u003e-Retro-styled match-3 puzzles\u003cbr\u003eWe’ve built our puzzles around items based on popular snacks from the Showa Era in Japan. All you’ve got to do is move them around and match them up! It sounds simple, but we’ve put enough depth into these puzzles to keep you on your toes.\u003cbr\u003e\u003cbr\u003e-Pick-up-and-play puzzles you won\u0026#39;t want to put down!\u003cbr\u003eMatching the pieces nets you powerful items like bombs that keep things feeling fresh. Got an irritating piece you can’t match up? Blast it off the screen! You can also combine items to produce even wilder effects. You’re gonna love discovering them all!\u003cbr\u003e\u003cbr\u003eCandy Shop Memories\u003cbr\u003e-Recall the candy shops of your youth\u003cbr\u003eEveryone has that one shop they loved as a kid. What if you could help a kindly old lady run a shop like that in Japan? The kind of shop you always wanted to go back to, no matter the season or when you’d last been. This one starts sleepy, but with your help we can make it a happening place!\u003cbr\u003e\u003cbr\u003e-Collect trinkets based on retro Japanese toys!\u003cbr\u003eHead over to the capsule toy machine whenever you get tired of puzzling! Give it a whirl and see what pops out. You’ll feel like a kid again, filling out a collection of little treasures! Open this up any time the modern world’s got you feeling stressed, and you’ll end your play session wondering what you were so worked up about."],"GAGEX Co.,Ltd.","50,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/DpDMVhYUpO_cuHSziRg0dpzhhL9v6wKv9S2ZGLxNGGQ3b7vz7ZsYD5bD1Zj0HfWvSwqMpqHekN-t5tWQsMsZTg"],null,[239,230,209,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,[null,"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted."],[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003djp.co.gagex.ankaa\u0026rdid\u003djp.co.gagex.ankaa\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 14.000 - Rp 1.490.000 per item",[0]],{"101":[null,[[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/4zAT73G-be754YPNd0a0bYbFKIWWk_7Fo-HMaJiKLmbTI-XKfrdtKZVwPXe1_xeeyLxyRDHCPZRpTxW4zJYh"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/_ZFyITfmtBC9jGNMA93fNdMyAOQQVuLROD1c9e9KUpk4o__dgos7gWH1E-V7WKYnyZNvQlctPWIkTUtFb63V"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/D9XWSNFflG97crXcLZbPsEDJ2LqDAEzqtVDzxQr6guaLlYYCXvb1Ak7TITuEVNWDlwwXLZCYJD0IqEn7EPbr0xs"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/4zAT73G-be754YPNd0a0bYbFKIWWk_7Fo-HMaJiKLmbTI-XKfrdtKZVwPXe1_xeeyLxyRDHCPZRpTxW4zJYh"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/_ZFyITfmtBC9jGNMA93fNdMyAOQQVuLROD1c9e9KUpk4o__dgos7gWH1E-V7WKYnyZNvQlctPWIkTUtFb63V"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/D9XWSNFflG97crXcLZbPsEDJ2LqDAEzqtVDzxQr6guaLlYYCXvb1Ak7TITuEVNWDlwwXLZCYJD0IqEn7EPbr0xs"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/4zAT73G-be754YPNd0a0bYbFKIWWk_7Fo-HMaJiKLmbTI-XKfrdtKZVwPXe1_xeeyLxyRDHCPZRpTxW4zJYh"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/_ZFyITfmtBC9jGNMA93fNdMyAOQQVuLROD1c9e9KUpk4o__dgos7gWH1E-V7WKYnyZNvQlctPWIkTUtFb63V"]],[null,2,[1080,1920],[null,null,"