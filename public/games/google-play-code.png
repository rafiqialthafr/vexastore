tps://play-lh.googleusercontent.com/9s4tUif7l2fS0uQyADf6dD_pZUOXg4L98U2rxeZW0QRrkkr_trK1tRh_w3vKv3JDflzEdLQutAEngalMpOHMFA"]]],"Magic Chess: Go Go",["4.1",4.105921],"Strategy",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.mobilechess.gp\u0026rdid\u003dcom.mobilechess.gp\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.mobilechess.gp"]],["\u003d"],[[[null,null,"GOOWnt8QMWA",[null,null,"https://www.youtube.com/embed/GOOWnt8QMWA?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:GOOWnt8QMWA",null,null,null,null,"AXH1ezkpvub2pT9cXYH5DC98uk4P28zmQ8hmpTLyj0r5A5jBbguubmdM4G12iSyP4uW6eZCgAMPIfcCiVo0kJit21hmtsFKKj3TPd-eirX8ZSNfezvwWGQOHWfF3oOlk_MDaCMLaNpaT64DMiUE1gLQ0u8PfJY4tFatsWn4FTCTRutx5cLMZjuvjZK4UwwmHTT85pgfyHoHdE_Fw4J3dAtpoqIIyOdikK1xzhgqwYM0uJlefcPvzHFxa7ZKs-yOBFS9LvZvh2E93FHN6OKoeGCu157SRdYnZkDc5pF71DFJZ8gs\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/GOOWnt8QMWA/hqdefault.jpg"]]]],[null,"A New Strategy Game from the MLBB Team! \u003cbr\u003eWelcome to Magic Chess: Go Go, the ultimate strategy game combining MLBB heroes with fresh and casual gameplay. It\u0026#39;s not about fast mechanics, but about wisdom and a touch of luck! Play anywhere, anytime, and have fun with friends!\u003cbr\u003e\u003cbr\u003eNew Battleground for MLBB Heroes: Strategy Fully Upgraded\u003cbr\u003eLead your favorite MLBB heroes in an all-new way. Recruit, merge, and strategize to form the ultimate lineup.\u003cbr\u003e\u003cbr\u003e8-Player Showdown: Outwit to Become the Champion\u003cbr\u003eFace off against 7 others in a tactical battle of wits. Want more fun? Team up with friends and show them who the real strategist is!\u003cbr\u003e\u003cbr\u003eUnique Commander Skills: Your Tactical Edge \u003cbr\u003eEach Commander brings exclusive skills that let you create bold, personalized strategies to dominate the game.\u003cbr\u003e\u003cbr\u003ePowerful Cards: Key to Lucky Comebacks\u003cbr\u003ePick from various Go Go Cards at key stages to maximize your advantage and turn the table. Every card could be the key to winning this thrilling chess battle!\u003cbr\u003e\u003cbr\u003eJoin MCGG now and master the board with strategy and style!\u003cbr\u003e\u003cbr\u003eCustomer Service Email: mobilechess.help@moonton.com\u003cbr\u003eOfficial Website: https://magicchessgogo.com/\u003cbr\u003eYoutube: https://www.youtube.com/@MagicChessGoGo"],"Vizta Games","10,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/utgVggwVjOKCDDFpMbX_c_DooPOoJ9go5uQW6OkMu7LWDbdioZtuOSZ_YN7GMkdrd9zwC3eI6eC7upapglT4TA"],null,[233,237,238,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],[null,"Moderate Violence"],[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.mobilechess.gp\u0026rdid\u003dcom.mobilechess.gp\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 2.700 - Rp 1.678.880 per item",[0]],{"101":[null,[[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/fyXnxb0pPj6-