ull,null,"https://play-lh.googleusercontent.com/2KPLYtrV7Jx_6OUBgl8Ng4Cij65rlhJMGvRKu_5R-kclJ5yrHjZA9AbKNXHJUMfMu21xJzmpf1uTLIM2Jen_Cg"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/mNz1l6-UMSpngmE6LUY4_g5H8Is787a5lmCrnylN3vY2ZhM-5qduAS9vBBnni4psDAidbXP1SxBVS010Gv21"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/F6IMCgm2R8j0z9L0ZRsDcQO7nPnVgtfSqfeRNqG81rJU2DD9eYo01HPMWvJsmN1wQv25oA6JF9jJHMU4IkTt"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/CavkHA3gBZxGSyBjjTWZRmx5LHnd2FdZYvYa_fxj_1n__e7qoNYV8sW2TCsGLSVuMW5rf5jyg8rv0mGO26J4hg"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/QUy5J_zwADxcEiXowMCH0wsxgRqvMe-HsK73KjJy2sxcjVGh1tfl8biN1bq5J32GrkScPRUZtMFuqHYzVDbX"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/gqpZ4r1q_clVTLynJZ56bjHKiE_3za2b0V4-9nUrYz9RHlpzGj41kaKCx_k24OguFALH84FRpiZX6Ef-qkB9Qg"]]],"Yes, Your Grace 2: Snowfall",["4.3",4.266667],"Role Playing",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.noodlecake.yesyourgrace2snowfall\u0026rdid\u003dcom.noodlecake.yesyourgrace2snowfall\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.noodlecake.yesyourgrace2snowfall"]],[""],[[[null,null,"q0-KM2H4R-c",[null,null,"https://www.youtube.com/embed/q0-KM2H4R-c?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:q0-KM2H4R-c",null,null,null,null,"AXH1ezmKRa7leXv_mplNEgLx96890sUIW9kfe3ZEFNuk7_dtf0cp1H1hYs5d3Mp-3rQnvRZJZsZqyhHyxQbTxLKkrJ7rIE9JVLFBA1CrcD_8jpECDV2EiwBtQHQ6vGGyNsM_JOV6XCICpL1tVpo9aa80NIwmQBhozlv5SDOpcFwyzZsODl-HoGUGifK7cCuyLwCkDw0NCt7VnJYEgw4lriCQiXHzRhZF7dKyuifNXNa61EWnnJFFzRt8GzcISXzeKROBBUNK3YvMEXJ-4O_MvQiHJZZTz_yqag5eyLJG2hrMhIU\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/q0-KM2H4R-c/hqdefault.jpg"]]]],[null,"*NOTICE - TRY BEFORE YOU BUY* - Play the beginning for free. A one-time in-app purchase unlocks the full game. No ads.\u003cbr\u003e\u003cbr\u003eYes, Your Grace: Snowfall is a cinematic kingdom management game. Take on the role of a King, manage resources, support your loved ones, and make difficult decisions to see you kingdom prosper or fail. Dive into a Slavic-folklore inspired world and deal with a queue of petitioners who will bring trouble, help, or laughter into your throne room. Decide whether to help them with their problems, or conserve resources for more important matters.\u003cbr\u003e\u003cbr\u003eTend to petitioners\u003cbr\u003eBalance your resources wisely to help those truly in need. Send your agents to aid the petitioners and decide who receives valuables from your treasury. As a Royal Monarch, you may demand taxes and pass laws but tread carefully, as each decision bears consequences.\u003cbr\u003e\u003cbr\u003eHire Agents\u003cbr\u003eEach agent brings a unique and invaluable skill set, alongside their distinctive personalities. While they can aid in resolving courtly matters, be wary—some may stir trouble with personal or romantic entanglements. Follow the agents’ stories, assisting them in resolving complex dilemmas, as you carefully select who will stand by your side in the impending war.\u003cbr\u003e\u003cbr\u003eCare for your family\u003cbr\u003eWatch your children grow as you try to keep the kingdom together. Taking care of your family will always take precedence - after all, their support can be the strongest pillar in rebuilding the safe home Davern once was."],"Noodlecake","100,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/5NBfuSDvjeiZ6pEPi2PbLveTkE_x4_2ap1ORKnaeA43zT1y3X3QOoppqf4T1VtNagXNszMLrR7yh6ri1PA-8FjY"],null,[14,15,34,255]],null,["Rated for 12+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg"]],[null,"Moderate Violence, Sexual Innuendo"],null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.noodlecake.yesyourgrace2snowfall\u0026rdid\u003dcom.noodlecake.yesyourgrace2snowfall\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 119.000 per item",[0]],{"101":[null,[[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/CavkHA3gBZxGSyBjjTWZRmx5LHnd2FdZYvYa_fxj_1n__e7qoNYV8sW2TCsGLSVuMW5rf5jyg8rv0mGO26J4hg"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/QUy5J_zwADxcEiXowMCH0wsxgRqvMe-HsK73KjJy2sxcjVGh1tfl8biN1bq5J32GrkScPRUZtMFuqHYzVDbX"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/gqpZ4r1q_clVTLynJZ56bjHKiE_3za2b0V4-9nUrYz9RHlpzGj41kaKCx_k24OguFALH84FRpiZX6Ef-qkB9Qg"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/VJzruUZzjmTwiZjODDr1RgpQ3adiqwmOTcjd7j3i1rfXN4wwgWIR8E_zya7wTGxxpzxC3xvV45GNU7xQ1G4e5FU"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/ZYHEU3wqe6apAyH167IRRAPi6asGJgz53c7MKMsbTiycMLwX-Y3OJwTDAm28i1kWhhIazpebszdH916GvjSv"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/2KPLYtrV7Jx_6OUBgl8Ng4Cij65rlhJMGvRKu_5R-kclJ5yrHjZA9AbKNXHJUMfMu21xJzmpf1uTLIM2Jen_Cg"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/mNz1l6-UMSpngmE6LUY4_g5H8Is787a5lmCrnylN3vY2ZhM