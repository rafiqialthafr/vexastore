ull,null,"https://play-lh.googleusercontent.com/8lCRPXXY4qv2wIn0KRo-AXfyMZtHb8rgDiNPV1hmtPvPfE2cjAaPrXMIjpwDU2ZFw6PamSeVZi_4H4FXu8yNHp8"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/UX5UUTPXkKK-QsNObkbW1l3SPT0N9Riz_JsgP7uVvcv9ihun0wUD22JGaD-ifYLCXIgMHecDmrPYGwyzpK-Z4w"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/7HU0DhIsi1aa6sBOl8XjZErXr4flFVFz0fexnb0J1-F9O2ZA2fYPy8VQadCY07kYmL8OdMheOJRwuhhZz08hHw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/PPKB1QXn4BrXpN6x7-KZ5piTbCwjwvDWJ896a9z5HVVE_dTR8N_Ipn3L617DWAaOEGeHUysmH-6-wLC3nY09bQ"]]],"Kingdom Rush 6: Genesis TD",["4.8",4.8333335],"Strategy",null,null,[null,[[119000000000,"IDR","Rp 119.000"]],null,[null,"Buy"],null,2,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.ironhidegames.android.kingdomrush6.genesis\u0026rdid\u003dcom.ironhidegames.android.kingdomrush6.genesis\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.ironhidegames.android.kingdomrush6.genesis"]],["\u003d"],[[[null,null,"fASj1oDxmLE",[null,null,"https://www.youtube.com/embed/fASj1oDxmLE?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:fASj1oDxmLE",null,null,null,null,"AXH1ezmVoRIdqfURKzIjWzJ2S403FzsL3ngZw2FpH1lG7Rw9aIDVs9EzFQFvnGN_h6Hv8AVygme6P5zZctVWODjwzR-d9tKUn18H8XHfJNFTpp_wJRne0pOZsYnfDXan8d5sIyRT_-yZf4wSviZb1qvo6_DuYdlmA_Uak0FXXMcg1TIQsMcwjGVuk5DLg3TZ_kabiylKo5wRN1XWQrFonBkI0rDLyve9g3Tmcxh2UlckoHxWe5bG_aEdFW_NNxkuoiVrQLA3FJhhBE1AnFceN7wTfnzaq8LG3r72fXQVNSu8ah0\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/fASj1oDxmLE/hqdefault.jpg"]]]],[null,"\u003cb\u003eWelcome to Kingdom Rush 6: Genesis,\u003cb\u003e\u003c/b\u003e the latest chapter in the legendary tower defense saga. Travel back to the dawn of Linirea, command epic heroes, and stop a young Vez\u0026#39;nan before the kingdom falls, on a battlefield where every tower placement matters.\u003cbr\u003e\u003cbr\u003eBuild, upgrade, and outwit waves of goblins, orcs, and worse across the original Kingdom Rush lands. Offline. Pure tower defense.\u003cbr\u003eHistory is broken. The Kingdom has fallen. And the only way to save the future is to defend the past.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eA PREQUEL WITH STAKES\u003cb\u003e\u003c/b\u003e\u003cbr\u003eReturn to the original Kingdom Rush lands at a time when legends were just beginning. Recruit familiar faces, revisit iconic battlefields, and uncover the moment that turned a young mage into the saga\u0026#39;s greatest villain.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e15 TOWERS, ENDLESS STRATEGIES\u003cb\u003e\u003c/b\u003e\u003cbr\u003eArchers, mages, barracks, artillery, every tower has a specialty, and the real game is the synergy between them.  Build your defense, lock the lane, watch the wave break. Classic tower defense, refined.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e12 LEGENDARY HEROES\u003cb\u003e\u003c/b\u003e\u003cbr\u003eTake two heroes into each battle and combine their abilities. Familiar Linirean champions return to your side, fighting beside you like the old days, and a few faces you\u0026#39;re about to meet for the first time.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e9 POWERFUL SPELLS\u003cb\u003e\u003c/b\u003e\u003cbr\u003eEquip a loadout of spells and unleash them at the moment that matters, meteor showers, powerful reinforcements, battlefield-wide control. Save them for the bosses. You\u0026#39;ll need them!\u003cbr\u003e\u003cbr\u003e\u003cb\u003e18 HANDCRAFTED CAMPAIGN STAGES\u003cb\u003e\u003c/b\u003e\u003cbr\u003eCross three landscapes of early Linirea, from the Citadel to the Stormcloud Depths and the far away lands of Arcania. Face 40+ enemies across 5 distinct races, and 6 colossal bosses standing between you and the future.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eTHE PLOT THICKENS\u003cb\u003e\u003c/b\u003e \u003cbr\u003eMore lore, more callbacks, and the Kingdom Rush humor that made you fall in love with Linirea in the first place.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eGAME MODES, ACHIEVEMENTS, AND EASTER EGGS\u003cb\u003e\u003c/b\u003e\u003cbr\u003eFor the ones who like to 100% everything: 50+ achievements, harder modes if you\u0026#39;re feeling brave, and easter eggs we had way too much fun hiding.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eOFFLINE, ANYWHERE\u003cb\u003e\u003c/b\u003e\u003cbr\u003eDefend the realm on the bus, on a plane, in a tower of your own. No connection required.\u003cbr\u003eDefend the past to change the future. Join the millions of players who have rallied to Linirea since 2011.\u003c/b\u003e\u003c/b\u003e\u003c/b\u003e\u003c/b\u003e\u003c/b\u003e\u003c/b\u003e\u003c/b\u003e\u003c/b\u003e\u003c/b\u003e"],"Ironhide Games","50,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/xVqjT1NKMpMxiK4pXTkiweA3d_fYHTDtt3VOZN_-PJCjOEiQaVlaqRl-fcXyp0qiiQvBWraRfk7sAoGDSQItCA"],null,[47,131,152,255]],null,["Rated for 7+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT"]],[null,"Mild Violence"],null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[119000000000,"IDR","Rp 119.000"]],null,[null,"Buy"],null,2,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.ironhidegames.android.kingdomrush6.genesis\u0026rdid\u003dcom.ironhidegames.android.kingdomrush6.genesis\u0026feature\u003dmd\u0026offerId"]],null,["CAE