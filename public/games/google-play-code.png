,"https://play-lh.googleusercontent.com/qmQk11BgPCJZ5idLKws1UJW6RmCIdeww8KhWwRRpkn4kAX5yCiI12EZ-K1aCK1_gc6-RS54fCOoxzFE9_XIKcg"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/hrpZdffP0Mt4nSZnr6FUk0OyeEm_GyXZ3TxCoQb7cSFoNOeF0KGEQoXgSR-PKqk1rlOyImJFvIPvZyXuoG3eXA"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/f4LkAVMiT4fqebZ3ylDD_Vwmhnm2rxiW49WXei5PQo82lhZJFcvjpl-YwQoO2MZOeRInCEjeDGLjl9vQ-eXwhQ"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/x7mGigxAUeg_-CiYmyYMVCx321iiK1BrHfrHt7Z0OC0iwsxu3usPPQX_9eGIdOEwqpdLpWPvkzrraJ9wUDJDqg"]]],"Mobile Legends: Bang Bang",["3.8",3.752681],"Action",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.mobile.legends\u0026rdid\u003dcom.mobile.legends\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.mobile.legends"]],["\u003d"],[[[null,null,"x891Pnvt4lA",[null,null,"https://www.youtube.com/embed/x891Pnvt4lA?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:x891Pnvt4lA",null,null,null,null,"AXH1ezlkGT7Kly2u4JArZw-Enq6Gcn4uUEG1Hyus1HfA6zrBdYywt_fmmynt512l9p9ix6yqdcBg_8SPW6Cv0W9-AAcZ1z6_dKwCcyQGqpMG5S2J0ZpiNfZc1t4lHul0RGm4u7F1j1NRrv9XLEI06WJMcFLWg2fPcR30AIahpWT5MaLcL4vCNNeoL_kvAgBOMKl66z3MI_xkFbnUhVZ-d4C5f2oemhqvMymZfyz_TCKqnq6Xr-1hc0nUE6_FCSKSOegwuXB6wwgto6fOzUGDP8u4h8VTlYAlo5Z2V0gvUKy7HaA\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/x891Pnvt4lA/hqdefault.jpg"]]]],[null,"Join your friends in Mobile Legends: Bang Bang, the brand new 5v5 MOBA showdown, and fight against real players! Choose your favorite heroes and build the perfect team with your comrades-in-arms! 10-second matchmaking, 10-minute battles. Laning, jungling, pushing, and teamfighting, all the fun of PC MOBA and action games in the palm of your hand! Feed your eSports spirit!\u003cbr\u003e\u003cbr\u003eMobile Legends: Bang Bang, the fascinating MOBA game on mobile. Smash and outplay your enemies and achieve the final victory with your teammates!\u003cbr\u003e\u003cbr\u003eYour phone thirsts for battle!\u003cbr\u003e\u003cbr\u003e\u003cb\u003eFeatures:\u003c/b\u003e \u003cbr\u003e\u003cbr\u003e\u003cb\u003e1. Classic MOBA Maps \u0026amp; 5v5 Battles\u003c/b\u003e \u003cbr\u003eReal-time 5v5 battles against real players. 3 lanes, 4 jungle areas, 2 bosses, 18 defense towers, and endless fights, everything a classic MOBA has is here!\u003cbr\u003e\u003cbr\u003e\u003cb\u003e2. Win with Teamwork \u0026amp; Strategy\u003c/b\u003e \u003cbr\u003eBlock damage, control the enemy, and heal teammates! Choose from Tanks, Mages, Marksmen, Assassins, Supports, etc. to anchor your team and be match MVP! New heroes are constantly being released!\u003cbr\u003e\u003cbr\u003e\u003cb\u003e3. Fair Fights, Carry Your Team to Victory\u003c/b\u003e \u003cbr\u003eJust like classic MOBAs, there is no hero training or paying for stats. Skill and strategy are all you need to be able to win the intense competition on this fair and balanced platform. Play to Win, not Pay to Win.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e4. Simple Controls, Easy to Master\u003c/b\u003e \u003cbr\u003eWith a virtual joystick on the left and skill buttons on the right, 2 fingers are all you need to become a master! Autolock and target switching allow you to last hit to your heart’s content. Never miss! And a convenient tap-to-equip system allows you to buy equipment anywhere on the map so you can focus more on the thrill of battle!\u003cbr\u003e\u003cbr\u003e\u003cb\u003e5. 10 Second Matchmaking, 10 Minute Matches\u003c/b\u003e \u003cbr\u003eMatchmaking only takes 10 seconds. And a match only takes 10 minutes. Gloss over the quiet early-game leveling up and jump right into the intense battles. Less boring waiting and repetitive farming, and more thrilling actions and fist-pumping victories. At any place, at any moment, just pick up your phone, fire up the game, and immerse yourself in the heart-pounding MOBA competition.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e6. Smart Offline AI Assistance\u003c/b\u003e \u003cbr\u003eA dropped connection could mean hanging your team out to dry in an intense match, but with Mobile Legends: Bang Bang’s powerful reconnection system, if you get dropped, you can be back in the battle in seconds. And while you’re offline, our AI system will take control of your character temporarily to avoid a 4-on-5 situation.\u003cbr\u003e\u003cbr\u003ePLEASE NOTE! Mobile Legends: Bang Bang is free to download and play, however some game items can also be purchased with real money. If you want to use this feature, please set up password protection for purchases in the settings of your Google Play Store app. Also, under our Terms of Service and Privacy Policy, you must be at least 12 years of age to play or download Mobile Legends: Bang Bang.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eContact Us\u003c/b\u003e \u003cbr\u003eYou can get customer service assistance via the [Contact Us] button in the game to help you with any problems you may encounter while playing. You can also find us on the following platforms. We welcome all of your Mobile Legends: Bang Bang thoughts and suggestions:\u003cbr\u003e\u003cbr\u003e\u003cb\u003eCustomer Service Email:\u003c/b\u003e mobilelegendsgame@moonton.com\u003cbr\u003e\u003cb\u003eInstagram:\u003c/b\u003e @mobilelegendsgame\u003cbr\u003e\u003cb\u003eYouTube:\u003c/b\u003e https://www.youtube.com/c/MobileLegends5v5MOBA"],"MOONTON","500,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/phgg4wQWtqyHlmDyEqx4ILOUvni7IQux9b5Ff41EomsObh4OrlAt6yT03dPHQ6ETO1jmyWDLbdOHFekJk9oLiQ"],null,[236,183,165,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],[null,"Moderate Violence"],[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.mobile.legends\u0026rdid\u003dcom.mobile.legends\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 3.000 - Rp 1.678.880 per item",[0]],{"101":[null,[[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/hrpZdffP0Mt4nSZnr6FUk0OyeEm_GyXZ3TxCoQb7cSFoNOeF0KGEQoXgSR-PKqk1rlOyImJFvIPvZyXuoG3eXA"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/f4LkAVMiT4fqebZ3ylDD_Vwmhnm2rxiW49WXei5PQo82lhZJFcvjpl-YwQoO2MZOeRInCEjeDGLjl9vQ-eXwhQ"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/x7mGigxAUeg_-CiYmyYMVCx321iiK1BrHfrHt7Z0OC0iwsxu3usPPQX_9eGIdOEwqpdLpWPvkzrraJ9wUDJDqg"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/rl_wfEdrOhxY8Ex-01gIbiCpl8W1bWvQAMx9XIEL_4jv3BsPooNt9zJgfGrICsL-Romap8Wa909DDxLenMNPhg"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/TKVjUlPCCKbnBU0yS-U2acLIpW0B9Zs2nC_CrnhyWTHReJmkyxs35e7aFYAkZ_bLYNzThThT2HeiRqUOrX5qRg"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/hremLaRO7K2_QYWVUpTcYOW0YENTZOrPhNGRcQWDB6rifBznc7itqf0Zm67-oT_uTFSbUuQfW44GFPQQB46y"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/qmQk11BgPCJZ5idLKws1UJW6RmCIdeww8KhWw