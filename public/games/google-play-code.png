null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.miraclegames.farlight84\u0026rdid\u003dcom.miraclegames.farlight84\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.miraclegames.farlight84"]],["\u003d"],[[[null,null,"4dRgumOJfn0",[null,null,"https://www.youtube.com/embed/4dRgumOJfn0?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:4dRgumOJfn0",null,null,null,null,"AXH1ezne6rGVZzD8bXabas4xyvU6tOoO6XwnCmkF1NIik1SOHEPIpad_Zkp04Zw0l_JlUevY7pjGoQZtDYQHYnCw_THqvXh6WC376FnSBsAg0TEF6VCMZOgl9-VsxZf76pnDc1GbmevrtGWrba0qWuE79oETHaAeA-xN-h5Ca1C8w28Se3FMRcDFR-K3-JYuEHR-YZvDUhwY0uwzXoPmn3x9iONfMm35aepOFTtMX41cyq4NtryTMbbBLdluPfd8l26xsdirbH5plNPvvlNf7yFnqiHhif5c_jSx-feiFT5v-JQ\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/4dRgumOJfn0/hqdefault.jpg"]]]],[null,"Hey, Lightcatchers! Welcome to Farlight 84! Are you ready for fast-paced hero shooter action with massive 60-player shootouts?\u003cbr\u003eTeam up with two squadmates and parkour your way through towering cityscapes as you hunt down your enemies. Play as uniquely skilled heroes, tame your Buddy pets, and unlock hundreds of tactical combos to outsmart your opponents. With unlimited respawns, you\u0026#39;re free to charge into the fray, break armor, and go all-out without fear! If you\u0026#39;ve got the guts, you\u0026#39;ve got the power to forge your own path to victory!\u003cbr\u003eSeason 4 of Farlight 84 begins April 23!\u003cbr\u003e\u003cbr\u003e[Fast-Paced Action in an Urban Jungle]\u003cbr\u003ePrepare to drop into a 60-player battlefield that pushes every limit!\u003cbr\u003eFrom open fields to vertical cities, team up and let the bullets fly! Run, climb, and fight your way to victory!\u003cbr\u003eLoot gear in tight alleyways, wall-run and slide between rooftops, zipline across bridges to reach the high ground, or launch across the map in a giant Rat Cannon. With layered, dynamic map design, every battle delivers endless exciting moments.\u003cbr\u003e\u003cbr\u003e[Get Straight Into the Action With One-Tap Looting]\u003cbr\u003eDon\u0026#39;t struggle with cumbersome controls. Become a master looter in an instant!\u003cbr\u003eWhen the battlefield turns hot, reaction speed is crucial. Enemy got the drop on you while you were trying to tweak your loadout? Not in Farlight 84! With the touch of a button, you can equip the best weapons and mods for an instant upgrade! Whether it\u0026#39;s shotgun chokes or long-distance sniper scopes, everything gets equipped automatically, so you can focus on what counts—take aim, fire, and win!\u003cbr\u003e\u003cbr\u003e[No Penalty for Newbies—Respawn and Hit Back Harder]\u003cbr\u003eKnocked out? Nope, you\u0026#39;re just getting started!\u003cbr\u003eIt\u0026#39;s not just about pulling the trigger—you\u0026#39;ll need to think on your feet and adapt on the fly. But if you make a mistake, your squad\u0026#39;s got your six. Even if you go down, you\u0026#39;ll be back in action in seconds and ready to strike back! No need to sit on the sidelines or shrink away from the fight—Even new players can become relentless battle machines!\u003cbr\u003e\u003cbr\u003e[Countless Combinations of Hero and Pet Skills]\u003cbr\u003eEach hero brings something different. So get ready to upgrade and expand your tactical playbook!\u003cbr\u003eChoose your moment, unleash your skills, and nail that kill! And don\u0026#39;t forget your Buddies—these tactical pets show up randomly, and they\u0026#39;re game-changers! They can summon storms, shift zones, disguise the terrain, steal items while invisible... They\u0026#39;re unpredictable, powerful, and always bring surprises to the fight!\u003cbr\u003eTry combining your weapons, heroes, and Buddies in different ways, and you\u0026#39;ll discover dozens of new ways to win!\u003cbr\u003eThere\u0026#39;s no one way to win. Every shot opens up new possibilities!\u003cbr\u003e\u003cbr\u003eEnjoy fast-paced hero shooter action in Farlight 84!\u003cbr\u003eNew season starts April 23!"],"FARLIGHT","10,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/dYKlZLlVEqYEysEnfBEDDD_oNnuxzSz9tipenwNpBXzD_aO_DLioH33hrQyoGThN2h53s1FihSoWgHrq_dIYqA"],null,[42,54,74,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],[null,"Moderate Violence"],[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.miraclegames.farlight84\u0026rdid\u003dcom.miraclegames.farlight84\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 16.000 - Rp 1.599.000 per item",[0]],{"101":[null,[[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/lzCSLNigDYuQt2TYrqvIX_ijA-OsjxC8S4fLo6vGf9N31oP2KchiToaqBYUhjbzcmBfpjU5EbbMTSR_jxre4"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/bOs1p6S4Kl0nAxuoITSHxrQupbHNG_Z_cXzljuWr4_-Li4sU5bm0I1AHZozhcFJOC6HQ5QJSB1b0PvUe6koSiQ"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/HOIRtQUb6Z1cWc7xmcIk35OUQHy-6nyRTCVBDoT-zTzece2IID1hXtABhfk0tRUBIzy8bKdro