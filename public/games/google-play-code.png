2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/ih0SKd7I0fn4VQ_qa6LVQC2K_HgLXIIVVVqgJAz7UGT4Oo9ep4qtMFTX_S9lFcGGT9aFW9FroyHzmUHkF80WiQ"]]],"Football League 2026",["4.3",4.292366],"Sports",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.football.soccer.league\u0026rdid\u003dcom.football.soccer.league\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.football.soccer.league"]],["\u003d"],[[[null,null,"eQgQDOcqmag",[null,null,"https://www.youtube.com/embed/eQgQDOcqmag?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:eQgQDOcqmag",null,null,null,null,"AXH1ezniXphxL6x2I0juRH4wjnDhaGrZX36yHaQYJ0_rC0-aISwwst5i3JXHNeJGxWCF826VJxVUIDMzuc4jFUc9sesx07YriAVkQ4jfPOsuys8nTRNpe6W8NYY87x8gPEDw7cCpYSxsmZdQmeEA2BAr5F7hm7S9cBxJo3mf9wOSr-IqrJi4d2svAYM10xo9bS4TJOfTIj2xXxmiz_YE1h7xsjLTIpdk7xS-Fx_fG2-i76W4mGJgMqPX4Q_oU8fphkS-X5crmtTg5kGMRF8b9B_p1V9s_ef6-o63I6oiA58lm-4\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/eQgQDOcqmag/hqdefault.jpg"]]]],[null,"VIVA WORLD SOCCER! Football League 2026 comes better than ever!\u003cbr\u003eTake the field with Manchester City and AS Monaco, fully licensed in FL26. Enjoy full 3D player action, a stylish UI, and stunning new stadiums. Play online or offline, tackle exciting events and challenges, and choose from multi-language commentary for a truly personal experience. Pick your squad and build your team from over 40,000 world players. This is your next-generation mobile soccer experience!\u003cbr\u003e\u003cbr\u003eUnleash the Action with Next-Level Player Animations and Smart AI:\u003cbr\u003eFeel every move with full animations\u003cbr\u003eChallenge yourself against more intelligent, unpredictable AI for the ultimate mobile soccer experience\u003cbr\u003e\u003cbr\u003eEnhance your experience with a Sleek Interface and Engaging Music:\u003cbr\u003eDive into a sleek, sporty interface designed for champions\u003cbr\u003eEnjoy dynamic background music that enhances your gameplay experience\u003cbr\u003e\u003cbr\u003eMulti-Language Commentary:\u003cbr\u003eGet lost in the roar of the crowd and the thrill of the match\u003cbr\u003eExperience commentary like never before, with multiple languages to choose from\u003cbr\u003e\u003cbr\u003eExplore the Thrill of Brand New Stadiums and Electrifying Atmospheres:\u003cbr\u003eStep into stunning new stadiums that put you right at the heart of the action\u003cbr\u003eFeel the energy of an upgraded stadium atmosphere that brings every match to life!\u003cbr\u003e\u003cbr\u003e【NEW FEATURES \u0026amp; FUNCTIONS】\u003cbr\u003eLatest New Jerseys and Soccer Balls: Choose from newly designed kits and a wide range of Soccer balls!\u003cbr\u003eCustomize Your Controls: Enjoy custom operating modes and enhanced handle support!\u003cbr\u003eNew Competitions: Dive into the revamped European Champions Cup format!\u003cbr\u003e\u003cbr\u003e【BUILD YOUR DREAM TEAM】\u003cbr\u003eMassive Selection of Teams and Players: Choose from over 40,000 players (men \u0026amp; women), 1,500 clubs, and 150 national teams!\u003cbr\u003eBuild Your Dream Team: Search for your favorite players and sign them to exclusive contracts!\u003cbr\u003eMaster the Game with Custom Tactics: Showcase your soccer skills with fully customizable tactics!\u003cbr\u003eLead Your Team to Victory: Create the perfect formation, win trophies, and become your team\u0026#39;s legendary manager!\u003cbr\u003e\u003cbr\u003e【SOCCER LEAGUES \u0026amp; COMPETITIONS】\u003cbr\u003eClassic National Cups\u003cbr\u003eInternational Cup (Men \u0026amp; Women)\u003cbr\u003eEuropean National Cup (Men \u0026amp; Women)\u003cbr\u003eAmerican National Cup (South \u0026amp; North)\u003cbr\u003eAsian National Cup\u003cbr\u003eAfrican National Cup\u003cbr\u003eGold Cup\u003cbr\u003eEuropean Nations League\u003cbr\u003e\u003cbr\u003e【CLUB LEAGUES】\u003cbr\u003eTop5 (England, Spain, Italy, Germany, France)\u003cbr\u003eAsian (Saudi Arabia, Japan, South Korea, India, Indonesia, Iran, Vietnam, Malaysia, Thailand)\u003cbr\u003eAfrican (Egypt, South Africa, Morocco, Algeria)\u003cbr\u003eEuropean (Croatia, Netherland, Belgium, Turkey, Portugal, Scotland, Russia, Greece)\u003cbr\u003eAmerican (Brazil, Argentina, Colombia, USA, Mexico, Ecuador, Peru, Paraguay, Venezuela)\u003cbr\u003eCustom League (Customize the league to your liking)\u003cbr\u003e\u0026amp; More coming soon\u003cbr\u003e\u003cbr\u003e【CLUB TOURNAMENTS】\u003cbr\u003eEuropean Champions Cup (old \u0026amp; new format)\u003cbr\u003eEuropean League Cup\u003cbr\u003eEuropean Conference Cup\u003cbr\u003eClub International Cup (with new format)\u003cbr\u003eSouth American Champions Cup\u003cbr\u003eAsian Super Champions Cup\u003cbr\u003eAsian Champions Cup\u003cbr\u003eAfrican Champions Cup\u003cbr\u003eAmerican Champions Cup\u003cbr\u003e\u003cbr\u003eFOLLOW US: https://www.facebook.com/playfootballleague\u003cbr\u003eDISCOVER US: https://www.instagram.com/footballleague_official/\u003cbr\u003eWATCH US: https://www.tiktok.com/@footballleague.official\u003cbr\u003eJOIN US: https://discord.gg/m825ft9xGn\u003cbr\u003eCONTACT US: footballleague2023@gmail.com"],"MOBILE SOCCER","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/jUK1zYUl7nCFn_YCljswZG-UfwNFAOSQmw-6YaGZ6T1t93qRTX_1qZuOCfyvHw7DJK3kwlnzWi2m1FpAky2f"],null,[161,159,154,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,[null,"In-Game Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercon