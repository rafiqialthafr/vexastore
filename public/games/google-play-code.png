,2,[2080,1280],[null,null,"https://play-lh.googleusercontent.com/cm5n7xY1-ntIbnhwcd-Y7KT4SzXWwJDB338Kxq1dfzKXPIGkLhTVy1qZLffoPAZB2qMTKmmO1nxXx7nAUNgpSQ"]],[null,2,[2080,1280],[null,null,"https://play-lh.googleusercontent.com/kQ4RyhmzOCXFQaWXzQ1wk6sD2IsWSMsHKUx5A3PGhu9JDOZUevZtbzlDhvLEwpnfBCygFVOwvUmApku_m3pcgrU"]],[null,2,[2028,1280],[null,null,"https://play-lh.googleusercontent.com/WOcD5_KGWMuh49a3Q5nb1lIiNCQEB9ZNyOGRXy7bg2z3nwr1a3V252kU9J6AMr9ZYQse_-gERFEgLxw-rg0aAmg"]],[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/kktT1t30b8q6vq22SfDP8vRcIeq918V-RcYco_vfB5HQjQM1pQwXn6heDOC_79btR2fO_WexFTJ5Nri_TufB"],null,[34,50,78,255]]],"Candy Crush Saga",["4.6",4.64973],"Casual",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.king.candycrushsaga\u0026rdid\u003dcom.king.candycrushsaga\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.king.candycrushsaga"]],["\u003d\u003d"],[[[null,null,"dmSuqklZT9I",[null,null,"https://www.youtube.com/embed/dmSuqklZT9I?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:dmSuqklZT9I",null,null,null,null,"AXH1ezlQloMmDmFAr2d1GAnmMCeEVg_7VhlTeymGE3jtOrWkJd1x1fm60c2FwmYCh11lGloazlEYlntpODqiEuyrVtaGPsG0FqhKvEds04wdBdN8UJR3-U64WTaeDiNH9DF2jygUmTmMIDxy1-Mzy1HkRkxXKoZXeTAryiXfMy_15ncIU1tpsf7D8moMpC2Wawei4tnHBKX4i3BASiHBcxuf5DrbpXWsf-VVKV7Bo8mpySXCsCumW88KQsWeZwhecQOfbXXYfBEbabLQB89dFNrjaon8zyFQinj9Aq3LiWTHf1U\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/dmSuqklZT9I/hqdefault.jpg"]]]],[null,"Master the legendary match 3 puzzle game from King and have a blast! With over a trillion matching levels played, Candy Crush Saga is the popular match 3 puzzle game!\u003cbr\u003e\u003cbr\u003eMatch, pop, and blast candies in this tasty puzzle adventure to progress to the next level and get a sugar blast! Master match 3 puzzles with quick thinking and smart matching moves to be rewarded with sugar bonuses and tasty candy combos.\u003cbr\u003e\u003cbr\u003eSpread jam by matching 3 or more candies in a row and blast your way through the extra sticky puzzles using jelly fishes! Blast jam and chocolate to collect sweet candy juice across thousands of puzzle levels, guaranteed to have you craving more!\u003cbr\u003e\u003cbr\u003eBECOME THE MASTER OF THE CANDY KINGDOM\u003cbr\u003e- Win thousands of sweet matching puzzles: with new puzzles added every 2 weeks, your sugar fix is never far away!\u003cbr\u003e\u003cbr\u003eWIN CANDYLICIOUS REWARDS\u003cbr\u003e- Spin the Daily Booster Wheel to receive jelly fishes and other tasty rewards! Master time-limited match 3 challenges to earn boosters and clear the jelly! \u003cbr\u003e\u003cbr\u003eVARIETY OF SUGAR-COATED PUZZLE GAMES\u003cbr\u003e- Sweet ways to play! Play match 3 game modes and more including Rainbow Rapids and Clear the Jelly. \u003cbr\u003e- Level up playing match 3 puzzles that range from easy to hard, accessible online or offline.\u003cbr\u003e\u003cbr\u003eBLAST CANDIES WITH FRIENDS\u003cbr\u003e- Match and pop candies to get to the top of the leaderboard! Compare scores with friends and find out who’s the match 3 master!\u003cbr\u003e- Enjoy the sweetest of match 3 puzzle games around! \u003cbr\u003e\u003cbr\u003eIf you want to master and blast even more puzzles, you may also enjoy other games from King: Candy Crush Soda Saga, Farm Heroes Saga, and Pet Rescue Saga.\u003cbr\u003e\u003cbr\u003eCandy Crush Saga is free to play but optional in-game items require payment. You can turn off the payment feature by disabling in-app purchases in your device’s settings.\u003cbr\u003e\u003cbr\u003eBy downloading Candy Crush Saga you agree to our terms of service which can be found at https://king.com/termsAndConditions\u003cbr\u003e\u003cbr\u003eDo not sell my data: King shares your personal information with advertising partners to personalize ads. Learn more at https://king.com/privacyPolicy. If you wish to exercise your Do Not Sell My Data rights, you can do so by contacting us via the in-game help center or by going to https://soporto.king.com/contact\u003cbr\u003e\u003cbr\u003eAll Stars Tournament\u003cbr\u003eSelected level 5+. 18+. In-game event 09:00 EDT 20 March to 03:00 EDT 27 April, 2025. Participating countries only. Win the in-game event and receive an invite to the live contest 11-13 June in California to compete for a share of $1,000,000 USD. Requires US travel. T\u0026amp;Cs: to.king.com/terms. App contains optional in-game purchases. © 2025 King.com Ltd."],"King","1,000,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/kktT1t30b8q6vq22SfDP8vRcIeq918V-RcYco_vfB5HQjQM1pQwXn6heDOC_79btR2fO_WexFTJ5Nri_TufB"],null,[34,50,78,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,[null,"In-Game Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.king.candycrushsaga\u0026rdid\u003dcom.king.candycrushsaga\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 3.000 - Rp 649.000 per item",[0]],{"101":[null,[[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/kktT1t3