ll,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.daerigame.scarecrow\u0026rdid\u003dcom.daerigame.scarecrow\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.daerigame.scarecrow"]],["\u003d\u003d"],[[[null,null,"f3v1UmZBwXo",[null,null,"https://www.youtube.com/embed/f3v1UmZBwXo?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:f3v1UmZBwXo",null,null,null,null,"AXH1ezk2Va_4jj50r7HWevEAZcJ1LWrJL2IEGuWcgJaFHI-TcBVVB1wwruqdrdBk35CYUcZMQ0Iu_pYQJm3y7446QoYDJWCX8JfmDwicL1Qjs8V6ffh8T3fEZiKCWxvfqf4uK1Zkb6hX4OGYp-E0GsTAiP5QX32TeNs8r4KqnLFg4qfSeUalKPpFCAnPTWpCLVrB8agnnzMBZtGGjEQTQDBm365UFpf4Wj7LUxcaLbzqAbsY_qlyCU_0cFsB4XooMF39yBXV6R5gWesk7Z6kCHRftXbzS29o8XGhKJ3SsIzS2zY\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/f3v1UmZBwXo/hqdefault.jpg"]]]],[null,"Great news has arrived for all the trainees who have devoted themselves to training in silence for so long!\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eContinue your training in the new Training Hero Remastered!\u003c/strong\u003e\u003cbr\u003e\u003cbr\u003eTraining Hero Remastered has been reborn with the Unity engine!\u003cbr\u003e\u003cbr\u003eCarry on the training record you have built over the years and begin training again in \u003cstrong\u003eTraining Hero Remastered\u003c/strong\u003e.\u003cbr\u003e\u003cbr\u003eTraining Hero has been restored with a brand-new engine.\u003cbr\u003eSo, can you expect new updates as well?\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eYou certainly can.\u003c/strong\u003e\u003cbr\u003e\u003cbr\u003eFor now, the original Training Hero has been restored on a new engine, but more powerful training and new content will be added soon.\u003cbr\u003e\u003cbr\u003eAttention, trainees ready to challenge your limits once again!\u003cbr\u003e\u003cbr\u003eThere are no shortcuts to strength.\u003cbr\u003ePush-ups, sit-ups, and long-distance running!\u003cbr\u003eTrue strength comes from staying faithful to the basics.\u003cbr\u003e\u003cbr\u003eEnjoy a one-of-a-kind 1-on-1 battle RPG unlike anything before or since!\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003e\u003cfont color\u003d\"#FF0000\"\u003eNo more, no less—just 10 minutes!\u003c/font\u003e\u003c/strong\u003e\u003cbr\u003eAnd so the training addiction begins!\u003cbr\u003e\u003cbr\u003e■■■■■\u003cstrong\u003eGAME FEATURES\u003c/strong\u003e■■■■■\u003cbr\u003e\u003cbr\u003e\u003cfont color\u003d\"#0000CD\"\u003eDevote yourself to training!\u003c/font\u003e\u003cbr\u003e\u003cbr\u003e■ \u003cfont color\u003d\"#FF0000\"\u003eTrain and experience endless growth!\u003c/font\u003e\u003cbr\u003eFun that stays true to the basics!\u003cbr\u003eFeel yourself grow stronger with every training session. Ba-bam!\u003cbr\u003e\u003cbr\u003e■ \u003cfont color\u003d\"#FF0000\"\u003eCombine and enhance a wide variety of equipment!\u003c/font\u003e\u003cbr\u003eCollect countless pieces of equipment and use Equipment Combination to create even more powerful gear.\u003cbr\u003e\u003cbr\u003eBig rewards without big spending!\u003cbr\u003eWe’ll keep showering you with rewards. Ba-bam!\u003cbr\u003e\u003cbr\u003e■ \u003cfont color\u003d\"#FF0000\"\u003eGrow stronger together with your Guild!\u003c/font\u003e\u003cbr\u003eClimb the Guild Ranking and make Donations to improve your Guild Buff.\u003cbr\u003eYou can also obtain various items from the Guild Shop.\u003cbr\u003e\u003cbr\u003e■ \u003cfont color\u003d\"#FF0000\"\u003eEnjoy a richly brewed 1-on-1 battle!\u003c/font\u003e\u003cbr\u003eA full-bodied combat experience brewed for 24 hours!\u003cbr\u003eDiscover the fun of 1-on-1 PvP through a system found only in Training Hero. Ba-bam!\u003cbr\u003e\u003cbr\u003eReborn with the Unity engine: \u003cstrong\u003eTraining Hero Remastered\u003c/strong\u003e.\u003cbr\u003e\u003cbr\u003eYour past training continues,\u003cbr\u003eand a new journey of training begins now.\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eWill you train with us once again?\u003c/strong\u003e\u003cbr\u003e\u003cbr\u003eYour valuable reviews give our development team the strength to create even more powerful training. ^^"],"DAERI SOFT Inc","5,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/dv6MtHcvlzIZrDLiRAyRMEPhvPKOwtlzjhi6F-a9bxXUgaXkZZM-PB77xIjOG-4Ab7-5SReJ2ETUzFGBkNAPSIk"],null,[153,189,246,255]],null,["Rated for 7+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT"]],[null,"Mild Violence"],[null,"Users Interact"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.daerigame.scarecrow\u0026rdid\u003dcom.daerigame.scarecrow\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 13.000 - Rp 599.000 per item",[0]],{"101":[null,[[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/nNf9q0F9Bn4lwY-LLpHCbmlE0yDxNguB-nm_3OrR-GnMXFK1Gu2YOn03dJJ46VeeVuxE8PGY5rSLdtEA2L9Xqr4"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/3kf27ELEYkg0kanLmHlwKpouwvmhY13OslH_oe3kSeKwJYs6z8fY9JIJnDsG2b_ZSclgq2N1XeWSAE4pDqdQJIg"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/JFyWvwuT9mw8wiUyb1p5GTaR_K98_DGZ72_nLWRqyKESdJj1gKuvP6GrF-ell