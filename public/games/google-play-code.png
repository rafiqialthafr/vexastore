2gl3_p2eRVSZLgRsAcmSFNfwX2B_2yV7B6qXxMWvxSMWrlxqaby4dG9QvopDk1BSeDZCikBgGlt6eZ4wza54g"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/O2gcRbmDaF8-xlQROIYNHkJrCz11w5bQKZNVzFy3WUZCIr1B23IQaw4r46GmYG2XManRd4RuHY6m-clzKQybuQ"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/_QqjQ4anhIgIggzDCOp4C6HiS3XxRDIOn8pN9nQUQHrXgHVnLwg8V13MhnR_hEOYzlKwJxNlqvYnsunf9Iw6Pw"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/hmJwh4KnL20fKoO7YWwQgMogAYlmoVOLmyl12GMSn_Njzv3ZpQ4vS9ziI5tBQZ3AnkwKHnj-ZD4S1jiLe5eF5Q"]]],"Angry Birds 2",["3.8",3.806027],"Casual",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.rovio.baba\u0026rdid\u003dcom.rovio.baba\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.rovio.baba"]],["CCGqAnAabggBShMI7YvXn6TXlwMVX7usAh0MMi4IsgRUClAKFAoOY29tLnJvdmlvLmJhYmEQARgDEhkKEzQ4MjgzMDU2NzU2MjQ2ODkyNjYQURgDGAMgAiiAqYW5ljQwgLG32Zg0QAFIAVoCCAFgAYABAjAI"],[[[null,null,"dSg_iqQpKYA",[null,null,"https://www.youtube.com/embed/dSg_iqQpKYA?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:dSg_iqQpKYA",null,null,null,null,"AXH1ezkSgTSZAa8TAxwQmd_c3tLwgBLxyCwSF8y0_8Ui6gZMevQa2HB66efT67RirDZ5EfBXIaWourg4x2UD-xy3TJMBY6ZrZCgCXq1xQLnerSj6skLc3hrH1sNQiVKpNLEhztBScl0J1JK5qlaJlZ0g8KPaSiD_uiTI67tunP4K3XRcXCZwCNo7r_aBK9DjwSCxPJ7y2z7tB4WiJF4RruCQm_mTCOSKtVDHqDe2wlBmUUuFf0Tgm0LKqKds1864X3w6XJFHutFJIaof820W32VAluQXZg3UtE0Zb1MIFLiZRoM\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/dSg_iqQpKYA/hqdefault.jpg"]]]],[null,"Join hundreds of millions of players for FREE and start the fun slingshot adventure now! Team up with your friends, climb the leaderboards, gather in clans, collect hats, take on challenges, and play fun events in all-new game modes. Evolve your team and show your skills in this exciting Angry Birds game !\u003cbr\u003e\u003cbr\u003eGet to know all of the iconic Angry Birds characters and experience the fun gameplay that has captured the hearts of millions of players.\u003cbr\u003e\u003cbr\u003eFeatures:\u003cbr\u003e\u003cbr\u003e● DAILY CHALLENGES. Have a minute? Complete a daily challenge and earn some quick rewards.\u003cbr\u003e● LEVEL UP your characters with feathers and up their scoring power. Build the ultimate flock!\u003cbr\u003e● JOIN A CLAN to take down the pigs with friends and players around the world.\u003cbr\u003e● COMPETE in the ARENA. Compete with other players for some friendly bird flinging fun and prove who is the best.\u003cbr\u003e● COLLECT SILLY HATS. Collect hats with different fun themes to level up your flock’s fashion game and take part in special events.\u003cbr\u003e● IMPRESS THE MIGHTY EAGLE in special challenges in Mighty Eagle’s Bootcamp and earn coins to use in his exclusive shop.\u003cbr\u003e● LOTS OF LEVELS. Play hundreds of levels with more added in regular updates and limited time events.\u003cbr\u003e● LEADERBOARDS. Compete with your friends and other players and prove who is the best on the global leaderboards.\u003cbr\u003e● CHOOSE YOUR BIRD. Choose which bird to put in the slingshot and defeat the pigs with strategy!\u003cbr\u003e● MULTI-STAGE LEVELS. Play fun, challenging levels with multiple stages – just watch out for Boss Pigs!\u003cbr\u003e● FREE to download! --- Angry Birds 2 is completely free to play. Although Angry Birds 2 can be downloaded for free, there are optional in-app purchases available.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e ---\u003cbr\u003eWhen playing this game, Rovio will offset the carbon footprint caused by the device’s energy consumption.\u003cbr\u003e\u003cbr\u003eThis game may include: \u003cbr\u003e- Direct links to social networking websites that are intended for an audience over the age of 13. \u003cbr\u003e- Direct links to the internet that can take players away from the game with the potential to browse to any web page.\u003cbr\u003e- Advertising of Rovio products and also products from third parties.\u003cbr\u003e\u003cbr\u003eAlthough some features are available offline, this game may require internet connectivity for certain features. Normal data transfer charges apply. Note: When the game is played for the first time, there is a one-time download of additional content that cannot be completed while offline.\u003cbr\u003e\u003cbr\u003eWe may update the game periodically, for example to add new features or content or to fix bugs or other technical issues. Please note that the game may not function properly if you do not have the newest version installed. If you have not installed the latest update, Rovio will not be responsible for the game failing to function as expected.\u003cbr\u003e\u003cbr\u003eTerms of use: http://www.rovio.com/terms-of-service\u003cbr\u003ePrivacy Policy: http://www.rovio.com/privacy"],"Rovio Entertainment Oy","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/fFYQHElIG2EDaKaIw9UHLf4Q23QDDEPUeXTo_Eu17SAAIoWgI31XXDyvpCvyvJxgqhgfBp-cfdEFhN-ekbf8GJ4"],null,[61,207,252,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],null,[null,"In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.rovio.baba\u0026rdid\u003dcom.rovio.baba\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 18.000 - Rp 4.490.000 per item",[0]]],[[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.rovio.baba"]],["CCGqAnAabggBShMI7YvXn6TXlwMVX7usAh0MMi4IsgRUClAKFAoOY29tLnJvdmlvLmJhYmEQARgDEhkKEzQ4MjgzMDU2NzU2MjQ2ODkyNjYQURgDGAMgAiiAqYW5ljQwgLG32Zg0QAFIAVoCCAFgAYABAjAI"],[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.rovio.baba\u0026rdid\u003dcom.rovio.baba\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]]],[null,"Spooky happenings in Angry Birds 2? Be brave, get the rewards!"],[null,"Ever notice how wings flutter differently around Halloween? But all the commotion pays off in gems, Black Pearls, feathers, and more. Swing the birds, crush the structures, clear the levels, and the rest will follow - a prize-filled experience to match the eerie season. This Spooky Treasure Pass is limited-time only - don\u0026#39;t let the treats go to waste. Trick or hit?"],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/Bd7eM9TqxyxEfrP-DOBOHAZiW6aHGcnZuo83CWCZBL4tO--VPaTCOM1yeGa0LjdDz8k7JKBc77GkSsv6oWsaHA"],null,[60,87,75,255]],null,"Update available",[null,null,null,null,[null,null,"/store/apps/eventdetails/4828305675624689266"]],2,null,["Angry Birds 2"],[[["Casual",[null,null,null,null,[null,null,"/store/apps/category/GAME_CASUAL"]],"GAME_CASUAL"]]]]],[null,[[["com.tocaboca.tocalifeworld",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/EQJQ_3OTKMq8h5ULR30LouHVfe-Ii5LDCR3jk_dlXZRlByJlVDlDndgw09GDE7c5-k9k8xiJ2DfEG5vw_v_q"],null,[254,254,254,255],null,null,null,2],[[null,2,[1206,2622],[null,null,"https://play-lh.googleusercontent.com/r9hmAT6Y9z5NNRqrasXzEyofxs4C1RkOajM3VAbY4sb0kkYqNBZWx-xH7hvn