560],[null,null,"https://play-lh.googleusercontent.com/srVbCWkXHfeJk_nYGGC2jbiM1sNw11uGsLNyKoKAQBIZC9YF4HSNmWNJ4zPF8PdEfeCYT7OPtR-YM9M05X94PA"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/HuFiEjDQQFVzigQKrYygxmQBX_BaTCpVXNzCshMVALsFAoZpX-A-gHd4rVzcaP8P3KDE3Ry_1pkpOs5jIq83OxI"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/2O12Jl7VIVsUpRoQIKJDlgyM7gFfcIGZvg1mdf74TzIHTh7dXQ6EXzgrbVYEoJi4zwBSDWOQ5cULLQJfmo0iUQ"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/pZYHp5j1u3RJF2UID3FVZTKnlLvK-HmlbzZM85ObeSr00e6_XPifBqU1fA_Hxv7-kyz3OC_AYIUcVNYj4vbW"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/LsawRbqk_iyOjjY_NkmKv62sTH9U4WqaF9juPzT0nhN4u9v52SHAfQliNaKpYZgo4KPN2j-cLVI44PhKpuAGJQ"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/8wCWhv0r5MAwGGIlL_H-wyQaiKDr4DlNdw3zKlCRu1YfT44aW_sq9ZWeIwku5aNpPTgZSZmp5_s1dgh4OnRT"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/PQkJeCIIB0ycrqPDKEnwhhLeCYXj0q2h5HB5oGxRPEplPe0EdZd5eYCb5WCAbB-UeNHqfeyIzXWC1Hn3afLg"]]],"Free Fire x NARUTO SHIPPUDEN",["4.4",4.4228377],"Action",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.dts.freefireth\u0026rdid\u003dcom.dts.freefireth\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.dts.freefireth"]],[""],[[[null,null,"CFb8-D7Gtk4",[null,null,"https://www.youtube.com/embed/CFb8-D7Gtk4?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:CFb8-D7Gtk4",null,null,null,null,"AXH1ezkgguQ60KUCIXrWpWvUdQDoNZaKRRogHxdNe3S5akiwTK6BsDp4N_4yeqpVKFArewkihIhEQykWaY3xSAfpUBWuDUBdV9jycZIL3UFGab5CllAvA6l5kHa9929FO1xDv3OYv3faxxG9uHcMCscKxdoTmr6QG-FBCUDEt3Oo9sYRhMbs0mCDtivs4F4s9uWuaodpuHHywaUQ14bW4R4LfXgZUhFGpJWYHfatjV0gNGWnrsLq7SG6TX-TZ7hf9kuL2TxjBxaruZZIMT5NlXfcPsZiMQ-4aInSudxWBHEC8Hw\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/CFb8-D7Gtk4/hqdefault.jpg"]]]],[null,"Ninjas unite. The Nine Tails is back!\u003cbr\u003e\u003cbr\u003eThe classic collaboration returns with the Hidden Leaf Village, Ninjutsu Scrolls, Reanimation Revival Points, and more, plus new gameplay, ninjutsu, and locations!\u003cbr\u003e\u003cbr\u003e[Nine Tails Strikes \u0026amp; Sharingan: Control]\u003cbr\u003eWhile players are on the plane, the Nine Tails can trigger random events such as forced parachute jumps, Arsenal openings, and supply drops. Capture Sharingan: Control to direct a Tailed Beast Bomb at any target area!\u003cbr\u003e\u003cbr\u003e[Ninjutsu Scrolls Return]\u003cbr\u003eFireball Jutsu, Water Dragon Jutsu, Chidori, Rasengan, and more are back. Try the new 8 Trigrams Palm Rotation to repel nearby enemies and block incoming shots with a spinning chakra defense.\u003cbr\u003e\u003cbr\u003e[Explore the New Ninja Academy]\u003cbr\u003eThe Hidden Leaf Village returns alongside the new Ninja Academy. Take a seat on the nostalgic swing at the school gate to relive iconic anime moments. Interact with it to get a buff!\u003cbr\u003e\u003cbr\u003e[Ninjas Unite Against the Nine Tails]\u003cbr\u003eComplete tasks to collect event tokens and unlock ninjas and their exclusive combo skills. Defend against the Nine Tails alongside them, and choose either the Jiraiya Bundle or Hinata Bundle as your grand prize!\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eFree Fire is a world-famous survival shooter game available on mobile. Each 10-minute game places you on a remote island where you are pit against 49 other players, all seeking survival. Players freely choose their starting point with their parachute, and aim to stay in the safe zone for as long as possible. Drive vehicles to explore the vast map, hide in the wild, or become invisible by proning under grass or rifts. Ambush, snipe, survive, there is only one goal: to survive and answer the call of duty.\u003cbr\u003eFree Fire, Battle In Style!\u003cbr\u003e\u003cbr\u003e[Survival shooter in its original form]\u003cbr\u003eSearch for weapons, stay in the play zone, loot your enemies and become the last man standing. Along the way, go for legendary airdrops while avoiding airstrikes to gain that little edge against other players.\u003cbr\u003e\u003cbr\u003e[10 minutes, 50 players, epic survival goodness awaits]\u003cbr\u003eFast and Lite gameplay - Within 10 minutes, a new survivor will emerge. Will you go beyond the call of duty and be the one under the shining lite?\u003cbr\u003e\u003cbr\u003e[4-man squad, with in-game voice chat]\u003cbr\u003eCreate squads of up to 4 players and establish communication with your squad at the very first moment. Answer the call of duty and lead your friends to victory and be the last team standing at the apex.\u003cbr\u003e\u003cbr\u003e[Clash Squad]\u003cbr\u003eA fast paced 4v4 game mode! Manage your economy, purchase weapons, and defeat the enemy squad!\u003cbr\u003e\u003cbr\u003e[Realistic and smooth graphics]\u003cbr\u003eEasy to use controls and smooth graphics promises the optimum survival experience you will find on mobile to help you immortalize your name among the legends.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e[Contact us]\u003cbr\u003eCustomer Service: https://support-freefiresg.garena.com"],"GARENA INTERNATIONAL I","1,000,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/gCqKm2I9J_UYBHsDOr1JdlBoG4kmBexI6FaY60s_E6j-m5ktRM645ybBcSuhFSdgNF6U_t8g_cYH7Em_i4rzMA"],null,[136,164,195,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],[null,"Moderate Violence"],[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.dts.freefireth\u0026rdid\u003dcom.dts.freefireth\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 1.400 - Rp 16.230.000 per item",[0]],{"101":[null,[[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/LsawRbqk_iyOjjY_NkmKv62sTH9U4WqaF9juPzT0nhN4u9v52SHAfQliNaKpYZgo4KPN2j-cLVI44PhKpuAGJQ"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/8wCWhv0r5MAwGGIlL_H-wyQaiKDr4DlNdw3zKlCRu1YfT44aW_sq9ZWeIwku5aNpPTgZSZmp5_s1dgh4OnRT"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/PQkJeCIIB0ycrqPDKEnwhhLeCYXj0q2h5HB5oGxRPEplPe0EdZd5eYCb5WCAbB-UeNHqfeyIzXWC1Hn3afLg"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/srVbCWkXHfeJk_nYGGC2jbiM1sNw11uGsLNyKoKAQBIZC9YF4HSNmWNJ4zPF8PdEfeCYT7OPtR-YM9M05X94PA"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/HuFiEjDQQFVzigQKrYygxmQBX_BaTCpVXNzCshMVALsFAoZpX-A-gHd4rVzcaP8P3KDE3Ry_1pkpOs5jIq83OxI"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/2O12Jl7VIVsUpRoQIKJDlgyM7gFfcIGZvg1mdf74TzIHTh7dXQ6EXzgrbVYEoJi4zwBSDWOQ5cULLQJfmo0iUQ"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/pZYHp5j1u3RJF2UID3FVZTKnlLvK-HmlbzZM85ObeSr00e6_XPifBqU1fA_Hxv7-kyz3OC_AYIUcVNYj4vbW"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/LsawRbqk_iyOjjY_NkmKv62sTH9U4WqaF9juPzT0nhN4u9v52SHAfQliNaKpYZgo4KPN2j-cLVI44PhKpuAGJQ"]],[null,2,[1600