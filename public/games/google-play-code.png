nt.com/8Y5QILtZ339FetqDRo-B1cjqsYbqwkJzjfLEfAAMq1B2esgW-yCi7X6U__-gUJhGLB2aiZDN-KVPkObl6ePO"]],[null,2,[1920,1200],[null,null,"https://play-lh.googleusercontent.com/MPOVsDWf5LYww1eLz-flrzERKQROFa1ZGdlcdA-SWC0TzKjU0p1WW6GOSiYx77-xbrJbi_VFJ2eTNinJm06daw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/pfYPieMd2GWfzJlE9ttzgAv2inKFqtazeOIgJy7SeofmqRqhAJA6-bJXIq_3P7MBwyO7HTzatbGkDhaHIeuA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/eLFun0Mtr911phPCL1krtSkc9x0-7VKOG1A29mPVhj0Wbg_fokBOic1TKKJgKsOM35-MTh1-dFPrMeEyKmuy"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/BA4u3bu2_v2LUcH16wmuxLVQSzkESTsXiC-eKuxIikqVfpboDOBRZQBvCMrzd99rlDtbmzalWVmKP5jS86P-"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/Up-pOppSPXOaV_CHJImXJsc4iqX6TdPk-95pZAe3tleoXq5_wAGVyGa9bW2bM5rveFXreuEMkvSYoTQ_bNlHEbs"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/pyvjJtWX7DH-jY88W1rXEO6FOF083iu4LF-fAJGGTRVXC8fDgnwPOLp-RzI-n3pqFM84_98csk5o1tvoR688"]]],"My Cat - Virtual pet simulator",["4.2",4.222646],"Simulation",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcat.game.liftapp\u0026rdid\u003dcat.game.liftapp\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcat.game.liftapp"]],["CCGqAnAabggHShMI7YvXn6TXlwMVX7usAh0MMi4IsgRUClAKFgoQY2F0LmdhbWUubGlmdGFwcBABGAMSGQoTNDgyOTUzMjE0NzYyNTk3NzkyMxBRGAMYAyAFKIDApM+PNDCA4OzQmDRAAUgBWgIIAYABAjAI"],null,[null,"Have you been dreaming of getting a pet? Your dreams are coming true with My Cat. Get a kitty with the cutest pet simulator ever.\u003cbr\u003e\u003cbr\u003eMeet your new virtual fluffy friend in simulation games. Just look into these honest cats eyes. They are melting your heart already, right? Now you can listen to its happy pleasant purr-purr engine all day long. Play with your little kitten, give it the most delicious yummies, take it for a walk and have fun every day. Our cat game is made for joy. Love your cat and it will love you back 😻\u003cbr\u003e\u003cbr\u003eThe only virtual cat that looks like and feels like a real cat. Oh, those charming cat manners. Kitten games will make you laugh every day and will become your best friend. You can even say “This is my talking pet”. It is so amazing to play with a tamagotchi cat. Take your kitty wherever you want, it is always by your side. You’ll always have fun with your fluffy friend.\u003cbr\u003e\u003cbr\u003e\u003cu\u003eYour purring friend needs your love and attention. Discover the My Cat\u0026#39;s adventure world.\u003c/u\u003e\u003cbr\u003e\u003cbr\u003eMY CAT GAME FEATURES: \u003cbr\u003e\u003cbr\u003e🎮 AUGMENTED REALITY. Use your smartphone camera, and the kitten will appear in your house.\u003cbr\u003e📸 FUNNY MEMORIES. Take cute photos of your talking cat to share with friends and show off on social media.\u003cbr\u003e🎁 EXTRA ITEMS. Take care of a cat, play with it, and enjoy extra items as a reward.\u003cbr\u003e💓 SO REAL. Cats react to your every touch. Stroke it or scratch its cute little nose with your finger. It is so easy to turn on your kitty’s purring engine.\u003cbr\u003e🐈 MORE FUN. While your virtual pet is asleep or occupied with some important cat business you can set new records in an exciting Summer Job merge games or mini games.\u003cbr\u003e\u003cbr\u003eShow everyone how adorable your kitten is with our pet simulator. Сatch cat adventure, how cat talks, plays, and all the moments spent together with your tamagochi friend. Take amusing and memorable selfies with your AR cat and collect them in the photo gallery. But don\u0026#39;t let your cute little virtual cat wait for too long. Cat games made for fun. Everyone loves playing My Cat.\u003cbr\u003e\u003cbr\u003e\u003cu\u003eIt is your time to get a cat. Give it all your love, and you will have the most faithful fluffy friend ever.\u003c/u\u003e\u003cbr\u003e\u003cbr\u003e👑PREMIUM ACCESS👑\u003cbr\u003eSubscribe for Premium and get unlimited access to all the game features:\u003cbr\u003e\u003cbr\u003e⭐️ Unlock all premium items\u003cbr\u003e⭐️ Unlock AR mode\u003cbr\u003e⭐️ Free daily coins\u003cbr\u003e⭐️ No Ads\u003cbr\u003e\u003cbr\u003eIt is your time to get a talking cat and make your dream come true. Give it all your love and you will have the most faithful fluffy tamagotchi friend ever. Enjoy playing with My Cat virtual kitty. 💟"],"Appsyoulove","50,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/s3hHMLn6eG_nLji9-eMd2m8E6-iDy6K3GcTSzXWWUBm0Qv-3QCn_np63e24HJUvoZGYrhPMmYqU6N85Qehxg"],null,[109,63,133,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,[null,"In-Game Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcat.game.liftapp\u0026rdid\u003dcat.game.liftapp\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 17.000 - Rp 1.490.000 per item",[0]]],[[null,null,null,null,[null,null,"/store/apps/details?id\u003dcat.game.liftapp"]],["CCGqAnAabggHShMI7YvXn6TXlwMVX7usAh0MMi4IsgRUClAKFgoQY2F0LmdhbWUubGlmdGFwcBABGAMSGQoTNDgyOTUzMjE0NzYyNTk3NzkyMxBRGAMYAyAFKIDA