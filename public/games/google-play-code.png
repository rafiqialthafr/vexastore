jtv8c8Qi_IuMJHevMw0pOslWPeA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/hpr2Uq_YYwTVQE8S_nt-zgipEU7yA4G_TM5ZEEEuoQCyg6rRRF9GbJaKYzzn2pV_r45R8EQwzSp-IB8npzJe"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/U3gdVy_wpba1PP9nRp6Dvt223qec7D6QHLGhzvahqWFxAr6J6ItEuDZTc9SkdqDXt5YK151q7tPBno4cnt_5Cw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/8NC4uO7O2WYnO3gH4THIjAI1OS_Zein85Dbrj4cS9KCZJd4n3qvLG41oC9AND0o3mP4rhuFU6C5TeIULZZi3Og"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/GNtbKFovtPSMQaYG52xiX_wQooI1NgGOKhW1GynefrCJFHCmV4c1eaJmr7GmWSSqIzfkcYh-7in3SZLfKVT7Nw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/_9yLgam0oYHlgl1Govx7udSMlYsmlh5UUgpb_u9HofrDij6D_5qPNx2AjCQBSydDZzo6890uY1NNHM3uYkVT0w"]]],"Three Kingdoms: RoS",["4.5",4.504673],"Strategy",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.bhk.newslgfz\u0026rdid\u003dcom.bhk.newslgfz\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.bhk.newslgfz"]],["\u003d"],[[[null,null,"4GjQp9xBGPs",[null,null,"https://www.youtube.com/embed/4GjQp9xBGPs?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:4GjQp9xBGPs",null,null,null,null,"AXH1ezkem9IY8PTfOQK84klmydHiT9J6f6aNGmksG0AeI8IhFwbRh3yKA7ow6e5QivbrIxRkNl1PbKHnRFC7LkkQvwtrvRv7Vz6r-iD8JYkVWqlujAg2ND0SWXrY-ym2eyeZksnRWl_uF8YKr39zAFavBmp6fpNW9yF-ed2gT0mK52AdGgys7Slau3Cz5mstOY6ES1VyERml5sIgE-fBi4HpJMG_bnhXy4sZAFzHvhAaYVdY3PbRJqNr_vxRuuTZbcdShZlwpbjMkrEssHwPqftwZwR4dL1zSKuVmwPvjpx2FmU\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/4GjQp9xBGPs/hqdefault.jpg"]]]],[null,"A sensation across Asia with over 10 million players battling together, Three Kingdoms: Realm of Strategy ushers in a new era of class-based war strategy.\u003cbr\u003eBecome a lord in a time of chaos, recruit legendary Three Kingdoms heroes, build diverse battlefield lineups, and take part in massive realm-wide wars!\u003cbr\u003e\u003cbr\u003eHere, war is only the beginning.\u003cbr\u003eYou will gather resources, develop your land, build cities, store supplies, and train troops, growing your power from a single small city.\u003cbr\u003eJoin an alliance of up to 200 players, conquer cities and seize territory with your allies, and expand your domain.\u003cbr\u003eIf diplomacy is your strength, you can form distant alliances, strike nearby rivals, and shape the fate of the realm through negotiation and strategy. In the end, march into Luoyang and become a hero of your age.\u003cbr\u003e\u003cbr\u003eThis battlefield is not a contest of numbers, but a battle of minds.\u003cbr\u003eWith troop-type counters and hundreds of tactic combinations, victory or defeat can turn on a single decision.\u003cbr\u003eAcross a vast sandbox world map, set ambushes in valleys, form battle lines on the plains, and create miracles where the few defeat the many.\u003cbr\u003eThe innovative Frontline Provisions system makes supply lines and transport a true part of warfare.\u003cbr\u003eWe promise: no resource-selling, no VIP system, and a truly fair competitive environment.\u003cbr\u003eVictory will always belong to those who think further ahead.\u003cbr\u003e\u003cbr\u003eThe game introduces an original six-class role system: Tactician, Vanguard, Pathfinder, Physician, Provisioner, and Artisan. Each plays a distinct role while working together with the others.\u003cbr\u003eTacticians can launch fire attacks and cut off supplies, disrupting enemy logistics.\u003cbr\u003ePathfinders can move stealthily and ambush key targets.\u003cbr\u003eArtisans can build siege engines, making sieges far more efficient.\u003cbr\u003eIn thousand-player siege battles, class coordination is not just support. It directly affects supply lines, tactical options, and the final outcome.\u003cbr\u003eWar is not decided by power alone, but by roles, teamwork, and strategy.\u003cbr\u003e\u003cbr\u003eThe game also includes many innovative features designed to cut down on grind and lighten the burden:\u003cbr\u003eauto-pathing, scheduled sieges, and auto-training.\u003cbr\u003ePlus, you are guaranteed a Legendary hero within 20 draws.\u003cbr\u003eWith heavy progression burdens removed, early development is easier and conquest feels faster and more satisfying.\u003cbr\u003e\u003cbr\u003eWhether you are a veteran strategist or a newcomer entering the battlefield for the first time, you can get started with ease.\u003cbr\u003eNo late-night check-ins required, just pure strategic enjoyment.\u003cbr\u003e\u003cbr\u003eOn this chessboard of chaos, how many tactical possibilities can you create?\u003cbr\u003eEnter with wisdom. Conquer through strategy.\u003cbr\u003e\u003cbr\u003e[Game Features]\u003cbr\u003eYour Kingdom. Your Legacy. \u003cbr\u003eBuild Your City. Raise Your Army. Fight for Your Alliance!\u003cbr\u003e\u003cbr\u003eMassive Battles. Legendary Wars.\u003cbr\u003eJoin a 200-player Alliance and Fight Alongside Players from across Asia.\u003cbr\u003e\u003cbr\u003eNo VIP. No Pay-to-Win. \u003cbr\u003ePlay a Little Each Day and Keep Growing!\u003cbr\u003e\u003cbr\u003eChoose Your Class.\u003cbr\u003eFight, Build, Scout, Heal, or Support—Every Class Matters.\u003cbr\u003e\u003cbr\u003eStart Strong from Day One.\u003cbr\u003eGet 3 Legendary Heroes and 125 Draws to Build Your Dream Team!\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eOfficial Website:newslg-en.biligames.com\u003cbr\u003eOfficial Fan Page:https://www.facebook.com/newslg.en/\u003cbr\u003eOfficial YouTube:https://youtube.com/@slgen-g3y?si\u003d-MNHDNlR2idbfLDL"],"BILIBILI","100,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/og6HTR4_FVdgwpgiyULMPqx1rODTAk5GpRSOFjggdAKGHOiH7GKvfx_tpHl5wzIXorp6a9ILuQ0g-1sUOty-Hsc"],null,[58,46,42,255]],null,["Rated for 12+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg"]],[null,"Moderate Violence"],[null,"Users Interact"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.bhk.newslgfz\u0026rdid\u003dcom.bhk.newslgfz\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 16.000 - Rp 1.599.000 per item",[0]],{"101":[null,[[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/8NC4uO7O2WYnO3gH4THIjAI1OS_Zein85Dbrj4cS9KCZJd4n3qvLG41oC9AND0o3mP4rhuFU6C5TeIULZZi3Og"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/GNtbKFovtPSMQaYG52xiX_wQooI1NgGOKhW1GynefrCJFHCmV4c1eaJmr7GmWSSqIzfkcYh-7in3SZLfKVT7Nw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/_9yLgam0oYHlgl1Govx7udSMlYsmlh5UUgpb_u9HofrDij6D_5qPNx2AjCQBSydDZzo6890uY1NNHM3uYkVT0w"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/Go_EEyzdertwNiwrG5laGf8hltcZZnzqSO3xqCbGKnKRpkWvpKCGTp0iraQjtv8c8Qi_IuMJHevMw0pOslWPeA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/hpr2Uq_YYwTVQE8S_nt-zgipEU7yA4G_TM5ZEEEuoQCyg6rRRF9GbJaKYzzn2pV_r45R8EQwzSp-IB8npzJe"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/U3gdVy_wpba1PP9nRp6Dvt223qec7D6QHLGhzvahqWFxAr6J6ItEuDZTc9SkdqDXt5YK151q7