tent.com/oOXRBVwGGwUSpTGhUxUJZIVnKbHVLVU9qF49_xnS25n1NcJvXhh9d_DSH2ztTv2W0vqYk966iTZ5IWSl2SdjSA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/GAGH-7F-EqAW4RW9br7yM2yarcafl-M-yrOpCehmH6mlProoce0VB_VAF8mnmWZCl86n3BT6U1K9IFh3p2mCgw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/4o03cydmg-Vth1JoU_PMuIxNUN9_WgsrHuA2l_MwkeASIzaYm-b2vzQTT5ID1b_XQzfJBZePe7dU3Zm88GXNFg"]]],"Solar Smash",["4.4",4.4427147],"Simulation",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.paradyme.solarsmash\u0026rdid\u003dcom.paradyme.solarsmash\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.paradyme.solarsmash"]],["\u003d\u003d"],[[[null,null,"NfQ7ScMkFyo",[null,null,"https://www.youtube.com/embed/NfQ7ScMkFyo?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:NfQ7ScMkFyo",null,null,null,null,"AXH1ezm6CNBIJZ_IWxB2gDXJeGlW908DD6WQv7KFWrIiGRxHTA0G-Ic8TUZ5KiGbOPi5Db9GTw1Wwt3P5ClEF6Mj4nIkoGnXjuKmIsBQS2qYb-c7qRXYZyrwNDwxojn7PURDTxqFcUKAG1OC6eePEAjshAduPdcCNHsD24JgIoKuZnpiMgsU1AeSLghkLjCdLEiw6yw230ylQQMnn9O4Zf1ieEl7MjFPSpgMUli1pjPsmAQ-pE8LSHq97wrAmnFYBX9QVKnINbeK8TaoVDVvmK41zyYdNqbydP7DwhCmvTi0sV4\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/NfQ7ScMkFyo/hqdefault.jpg"]]]],[null,"Harness the power of space and embark on an epic journey of creative destruction with Solar Smash, the ultimate physics-based sandbox simulation game!\u003cbr\u003e\u003cbr\u003e🌌 Simulate the Universe: Control the forces of nature and become a cosmic architect as you explore the boundless expanse of space. Craft and customize your own planetary systems, from the tiniest asteroids to massive gas giants.\u003cbr\u003e\u003cbr\u003e🪐 Two Thrilling Game Modes:\u003cbr\u003e\u003cbr\u003ePlanet Smash: Annihilate planets and moons with over 50 different weapons! Choose from lasers, meteors, nukes, antimatter missiles, UFOs, battleships, space fighters, railguns, black holes, space shibas, orbital ion cannons, supernovas, laser swords, giant monsters, celestial beings, and even defensive weapons like shields and defensive satellites. Destroy everything in your path in both familiar solar systems and exotic star systems with artificial megastructures like ring worlds and giant moons with planetary force fields.\u003cbr\u003e\u003cbr\u003eSolar System Smash: Dive deep into physics simulations and unleash your creativity in a mode that allows you to play with one of three star systems, including our very own Solar system. Or create your own star systems, complete with planets and set their orbits. Experiment with planetary collisions, create black holes to disrupt orbits, and engage in endless cosmic simulations.\u003cbr\u003e\u003cbr\u003e🌠 Realistic Physics: Experience the breathtaking beauty of scientifically accurate gravitational interactions and celestial mechanics. Witness the awe-inspiring consequences of your every action as you set celestial bodies on collision courses, triggering cataclysmic events that defy imagination.\u003cbr\u003e\u003cbr\u003e☄️ Unleash Your Creativity: It\u0026#39;s your universe to shape and reshape! Build, experiment, and destroy to your heart\u0026#39;s content. The power to craft worlds or obliterate them is in your hands. What will you create, and what will you obliterate in your quest for cosmic dominance?\u003cbr\u003e\u003cbr\u003e🌟 Destruction Like Never Before: Tear apart planets, cause supernovas, and create black holes that consume everything in their path. Embrace the chaos and experience the visceral satisfaction of witnessing your cosmic masterpieces crumble to dust.\u003cbr\u003e\u003cbr\u003e🎮 Intuitive Controls: Dive into the cosmos with easy-to-use controls designed for both beginners and experienced players. Explore the infinite reaches of the universe and let your imagination run wild.\u003cbr\u003e\u003cbr\u003eSolar Smash is the ultimate sandbox for those who crave both the creative and the destructive. Are you ready to make your mark on the cosmos? Download Solar Smash now!\u003cbr\u003e\u003cbr\u003eWarning\u003cbr\u003eThis game contains flashing lights that may make it unsuitable for people with photosensitive epilepsy or other photosensitive conditions. Player discretion is advised.\u003cbr\u003e\u003cbr\u003eSpace images credits:\u003cbr\u003eNASA\u0026#39;s Scientific Visualization Studio\u003cbr\u003eNASA\u0026#39;s Goddard Space Flight Center\u003cbr\u003eSpace Telescope Science Institute"],"Paradyme Games","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/8J3BnsIVIaEkN_mz7ThqrWliMneIdWUoo2w6eZgfBx7HEr4_LWNShC8rHryuScbvOUcvQRrCLZb_aQiwqT9Y2A"],null,[40,7,22,255]],null,["Rated for 7+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT"]],[null,"Mild Violence"],[null,"In-Game Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.paradyme.solarsmash\u0026rdid\u003dcom.paradyme.solarsmash\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 35.000 - Rp 269.000 per item",[0]],{"101":[null,[[null,2,[1080,1920],[null,null,"https://play-lh.googl