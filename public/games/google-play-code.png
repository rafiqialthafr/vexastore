,null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dfunvent.tilepark"]],["CCGqAnAabggDShMI7YvXn6TXlwMVX7usAh0MMi4IsgRUClAKFgoQZnVudmVudC50aWxlcGFyaxABGAMSGQoTNDgzMTEyOTc5OTU5NzU2MDUzOBBRGAMYASACKIDAu+KUNDCA4IPknTRAAUgBWgIIAYABAjAI"],null,[null,"Find your zen with a refreshing twist on tile matching! 🌳✨\u003cbr\u003e\u003cbr\u003eStep into a peaceful sanctuary designed to sharpen your focus and melt away stress. This soothing puzzle experience brings the beauty of a lush park to your screen, offering a perfect blend of strategy and relaxation.\u003cbr\u003e\u003cbr\u003eExplore the Park:\u003cbr\u003e• Match 3 🧩: Tap on three identical nature-inspired tiles to clear them from the board.\u003cbr\u003e• Master the Space 📥: You have 7 slots on your tray. Plan your moves carefully!\u003cbr\u003e• Clear the Landscape 🍃: Eliminate every tile to complete the stage and discover new garden layouts.\u003cbr\u003e\u003cbr\u003eWhy You’ll Love It:\u003cbr\u003e• Scenic Visuals 🌺: Enjoy beautifully crafted tiles that celebrate the beauty of nature.\u003cbr\u003e• Mindful Strategy 🧠: Think ahead to keep your tray clear and your mind focused.\u003cbr\u003e• Tranquil Gameplay 🌊: No timers or pressure—just you and the quiet challenge of the match.\u003cbr\u003e\u003cbr\u003eFind your rhythm among the greenery and enjoy the ultimate relaxing gameplay experience. Download now and start your stroll! 🌿✨"],"Funvent Studios Fzco","50,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/40LpoaTUfx2iLWFaI-V2XWE9ylr9SkW-v5tjIc0KAhncnQJSNn3SNN6wWurHkJ_HRCL2cTwXFnwxlK0GRzv-"],null,[115,119,122,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,[null,"In-Game Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u0