l,null,"https://play-lh.googleusercontent.com/6lCwGJaXiio50LLcxtGqsD_iC0MhCFEhWSQ3RmVq_5eP5a8YwtOUXy8ux-E-2FgwDsJhLvqggTzehGnV1oFSOQ"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/_O8TZ4egWD2Ew58B9R3LpxrXZID1WG-w2xj-37CNYTg9K2dbBJk9MPVKTQSXyj7a5T_0Q24GwmA6sh1rXTulYbA"]],[null,2,[1600,2560],[null,null,"https://play-lh.googleusercontent.com/RHbUGBYo9pB8lM1rR0MnqPzOsCmiGR88j1Uf_Q_dZAMSnlsC8zNtDg7wAhFq_HST4-szNTNhVD475uqMTCJa84s"]]],"Free Fire MAX x NARUTO",["4.6",4.6032066],"Action",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.dts.freefiremax\u0026rdid\u003dcom.dts.freefiremax\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.dts.freefiremax"]],["\u003d\u003d"],[[[null,null,"IGjKTIHRB5I",[null,null,"https://www.youtube.com/embed/IGjKTIHRB5I?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:IGjKTIHRB5I",null,null,null,null,"AXH1ezkrM1rbmGCLHU2MO96OBMoBdBlcicqMuLMAZWLe1IieebAaJkcgFHhBpUVXh0m0eTD3fZ9cHXfvB4RNyGkFPA83giNQFvTNUK6B6-wwsCIK-J5t_Yr0zOqLVP9owC27B5nt4tFQdf7YsjOcONNgbPolunPRgFX0YOGofRuc2DVQdFiGa_T1Wu5DLuM61SZ_ea2htt7Ku9gdoUbMzOPpMvB_5MDiGOYrzKDVzAaEdR-bykKKn4oBF2JG1W-7fvBZ0R31yH6wFbG5HuZrbAtJTnC_MC5mXwaXpMoo0X64IHQ\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/IGjKTIHRB5I/hqdefault.jpg"]]]],[null,"Ninjas unite. The Nine Tails is back!\u003cbr\u003e\u003cbr\u003eThe classic collaboration returns with the Hidden Leaf Village, Ninjutsu Scrolls, Reanimation Revival Points, and more, plus new gameplay, ninjutsu, and locations!\u003cbr\u003e\u003cbr\u003e[Nine Tails Strikes \u0026amp; Sharingan: Control]\u003cbr\u003eWhile players are on the plane, the Nine Tails can trigger random events such as forced parachute jumps, Arsenal openings, and supply drops. Capture Sharingan: Control to direct a Tailed Beast Bomb at any target area!\u003cbr\u003e\u003cbr\u003e[Ninjutsu Scrolls Return]\u003cbr\u003eFireball Jutsu, Water Dragon Jutsu, Chidori, Rasengan, and more are back. Try the new 8 Trigrams Palm Rotation to repel nearby enemies and block incoming shots with a spinning chakra defense.\u003cbr\u003e\u003cbr\u003e[Explore the New Ninja Academy]\u003cbr\u003eThe Hidden Leaf Village returns alongside the new Ninja Academy. Take a seat on the nostalgic swing at the school gate to relive iconic anime moments. Interact with it to get a buff!\u003cbr\u003e\u003cbr\u003e[Ninjas Unite Against the Nine Tails]\u003cbr\u003eComplete tasks to collect event tokens and unlock ninjas and their exclusive combo skills. Defend against the Nine Tails alongside them, and choose either the Jiraiya Bundle or Hinata Bundle as your grand prize!\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eFree Fire is a world-famous survival shooter game available on mobile. Each 10-minute game places you on a remote island where you are pit against 49 other players, all seeking survival. Players freely choose their starting point with their parachute, and aim to stay in the safe zone for as long as possible. Drive vehicles to explore the vast map, hide in the wild, or become invisible by proning under grass or rifts. Ambush, snipe, survive, there is only one goal: to survive and answer the call of duty.\u003cbr\u003eFree Fire, Battle In Style!\u003cbr\u003e\u003cbr\u003e[Survival shooter in its original form]\u003cbr\u003eSearch for weapons, stay in the play zone, loot your enemies and become the last man standing. Along the way, go for legendary airdrops while avoiding airstrikes to gain that little edge against other players.\u003cbr\u003e\u003cbr\u003e[10 minutes, 50 players, epic survival goodness awaits]\u003cbr\u003eFast and Lite gameplay - Within 10 minutes, a new survivor will emerge. Will you go beyond the call of duty and be the one under the shining lite?\u003cbr\u003e\u003cbr\u003e[4-man squad, with in-game voice chat]\u003cbr\u003eCreate squads of up to 4 players and establish communication with your squad at the very first moment. Answer the call of duty and lead your friends to victory and be the last team standing at the apex.\u003cbr\u003e\u003cbr\u003e[Clash Squad]\u003cbr\u003eA fast paced 4v4 game mode! Manage your economy, purchase weapons, and defeat the enemy squad!\u003cbr\u003e\u003cbr\u003e[Realistic and smooth graphics]\u003cbr\u003eEasy to use controls and smooth graphics promises the optimum survival experience you will find on mobile to help you immortalize your name among the legends.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e[Contact us]\u003cbr\u003eCustomer Service: https://support-freefiresg.garena.com"],"GARENA INTERNATIONAL I","500,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/5zknneX-sYhucAkKL0nGAmHn4_r7Vjc8t1Dx6iBLHJwivlnuhcJ7ChbHKfOvuXbrafuS-rNpvChuAEIcbwXw"],null,[136,164,195,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],[null,"Moderate Violence"],[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.dts.freefiremax\u0026rdid\u003dcom.dts.freefiremax\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]