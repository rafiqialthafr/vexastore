ntent.com/pKQ1-hyEHnfqU1Uo5qvg82UEAphduHnACfS7Id-oF3VqV1CxUFULxaAdqZep5BhxHVnoy27w6oiILOSWB4nbpQ"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/1LuSGp17d-zxrWs4ExfMzTBMG_VrfdCqGtFxTTfyEeBQPJEJnWfKDeKR_yPZV3LIDYSDumokw2AZW2HXtGNq"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/Ty08zNePgx_7VpI1mCiBsh_xTzWwhlk9VcDHSyfIdnOlQG-O7e0_mAPjQvY3m2nfMAdh671ytxH9MgpC-EVsWg"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/uofF6e29MGEATOw6l2JBbxp_PmNSAcszOpzvuhByNvQfpQhiQ5LEMs4QzMNlEmg8Bk5r87YVAhOFJgzLhPxP9A"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/IZEz3i0p_kzmAtvysUXafmxUHQk_8Q_n5jLDHN1mVzNilz6E5Zy3nO2Zjv6CtbDlO1o5AxUNvB5h6ZhKE_TuKA"]],[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/vueYxOPx95vE6izDdralBnWzEVl055G80os6-uIRaQTQu90W_H0OqclsknEC_Rg2-t8b4rSXU6kf1RlCUgSrzw"],null,[38,47,100,255]]],"Immortal Taoists - Idle Manga",["4.6",4.636136],"Word",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.immortaltaoists.en\u0026rdid\u003dcom.immortaltaoists.en\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.immortaltaoists.en"]],["\u003d\u003d"],null,[null,"\u003cfont color\u003d\"#FF1493\"\u003e\u003cb\u003eWonderful playble manga in 2025\u003c/b\u003e\u003c/font\u003e\u003cbr\u003e\u003cbr\u003eHappy 6th Anniversary! Enjoy the celebration together!\u003cbr\u003e\u003cbr\u003eExcellent Xianxia fiction-converted idle game in 2025! \u003cbr\u003e----------------------\u003cbr\u003e\u003cbr\u003e\u003cb\u003e\u0026#39;Immortal Taoists\u0026#39; The real immortal-cultivation idle game that you\u0026#39;ve never played before!\u003c/b\u003e😄\u003cbr\u003eStart from a young cultivator and discover your path to immortality, search for ancient ruins and fight against eternal demons, the first chapter of your personal cultivation novel begins here.\u003cbr\u003eAdventure now, become a novel protagonist and live a fantasy life!\u003cbr\u003e\u003cbr\u003e\u003d\u003d\u003d\u003d\u003d\u003d\u003dGame Features\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003cbr\u003e \u003cbr\u003e\u003cb\u003e☯Unparalleled Kungfu Skills\u003c/b\u003e\u003cbr\u003eIn this game, you will learn many different kinds of unparalleled Kungfu techniques, and a myriad of elemental, psychic and physical spells!\u003cbr\u003e\u003cbr\u003e\u003cb\u003e☯Great Treasures\u003c/b\u003e\u003cbr\u003eIn the Universe of Cultivation, spiritual energy fills the lands which teem with mystical treasures, rare herbs, magical talismans and even the fabled immortality elixir! Take what you find and craft powerful equipment, and refine powerful elixirs.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e☯Fortunate Destinies\u003c/b\u003e\u003cbr\u003eDo you want to be like the heroes in Wuxia novels? Live out your fantasy, whether seeking artifacts in the deep mountains, or cultivating in the temple\u0026#39;s peaceful serenity, there are countless good fortunes to be discovered! Even a seemingly poor beggar could be an ageless hermit waiting to offer you immortality with powerful spells. Make your choices and discover your destiny.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e☯Martial Sects\u003c/b\u003e\u003cbr\u003eYou can experience the many different Martial Sects in the world, make your choice and discover the stories of different sects. It doesn’t matter whether you are good or evil, a cultivators ultimate goal is to reach immortality regardless of means.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e☯Find your companion\u003c/b\u003e\u003cbr\u003eThe path of a cultivator can be a lonesome one, so wouldn\u0026#39;t it be wonderful to find a life long companion? Someone who is always with you and walks the path of cultivation by your side. It is very difficult for those who walk this path find true love, so please treasure the strings of fate that bring people together.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eYour immortal destiny is here, let’s cultivate together!\u003c/b\u003e\u003cbr\u003eFollow us for more information and exclusive free rewards：\u003cbr\u003e\u003cb\u003eFacebook: \u003cu\u003ehttps://www.facebook.com/com.immortaltaoists/\u003c/u\u003e\u003c/b\u003e\u003cbr\u003e\u003cb\u003eDiscord: \u003cu\u003ehttps://discord.gg/immortaltaoists\u003c/u\u003e\u003c/b\u003e"],"Entrepreneur Game","5,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/vueYxOPx95vE6izDdralBnWzEVl055G80os6-uIRaQTQu90W_H0OqclsknEC_Rg2-t8b4rSXU6kf1RlCUgSrzw"],null,[38,47,100,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],null,[null,"Users Interact, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.immortaltaoists.en\u0026rdid\u003dcom.immortaltaoists.en\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 4.800 - Rp 2.999.000 per item",[0]],{"101":[null,[[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/vueYxOPx95vE6izDdralBnWzEVl055G80os6-uIRaQTQu90W_H0OqclsknEC_Rg2-t8b4rSXU6kf1RlCUgSrzw"],null,[38,47,100,255]]],[[null,2,[2208,1242],[n