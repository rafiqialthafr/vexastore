-2Cn-fdUCWfAdnr19Ki2n9NZoZZx6FsjoFi_Ae2k"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/1cMUyXWhwiNhXAIzqUTl0PPJlFOLSOF4fJMXq8AguiSKD84AWy0sI0Wsj-x86u0EIeuR5vRut-bu-Kuf_hBkIog"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/mUGhDAzx-nSaEAB781mGpURvoTrCoE5umuB9OFW7gu3rlLjFjIivPbmyTTVYrex2_viCC6RvKsgAVQyOThhl"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/J7oIW--FosP2pLHrSaofHlBFNfhMs6ybZC4InwzJLGknhizes9ByBxfXsjZzfZoO2pZ-mXKUCSNNzYOyO7MmUA"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/u1NyAs5dxPNlm5WX4bHdjivSXIsFi6WYL7q4DrEJZlHrdLa6vuK20eQNAjeuQ7ZoJdRDIF_rUqXaEfFBORuLzg"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/q5Ysd3o7Mk5bgvcRAxZQs8hAp2T4iulYG1kbFtI5pu3w-Rh-2Cn-fdUCWfAdnr19Ki2n9NZoZZx6FsjoFi_Ae2k"]]],"Worms Zone .io - Hungry Snake",["4.4",4.404061],"Action",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.wildspike.wormszone\u0026rdid\u003dcom.wildspike.wormszone\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.wildspike.wormszone"]],["\u003d"],[[[null,null,"X2atQjS8Huo",[null,null,"https://www.youtube.com/embed/X2atQjS8Huo?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:X2atQjS8Huo",null,null,null,null,"AXH1eznFC2YgJPic0qiVHqjN1nLP1tVmitMs0ENATLIdyKK4Wmy3uT_9Idi3Bwf5YVKTOrSuL-HD2-Q77q_BPPIOvqWvSPH-BzMDSAs7PzXpug08IvkGTZ9F9HnvyL-cFioVDaw3d55FFkhX0IYh9FoUjdNLyqdoT-aSZSRSvW4aMR64hqM2R0V-5kBaif8SQGLd09T7LOrhnlgiHsn-IA4kAx3vyjAiPHxZyyb-fBHgEmcXzEQtFHEHeEA7TINdiq6lOAHpyUrlPU0Kgyq7nb0aWOekJNL3b4O01prgk13XaGM\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/X2atQjS8Huo/hqdefault.jpg"]]]],[null,"You love games with tons of real fun and dynamic action? Then welcome to the Worms Zone.io, an awesome arcade, where you can become the great champion of the arena! Collect yummies and different powerups, defeat enemies, and become the biggest worm of them all! \u003cbr\u003e\u003cbr\u003eYou think it\u0026#39;s hard? Relax, the rules are simple - explore the arena, collect all the food you see, and grow your worms as big as you can imagine - there are no limits! \u003cbr\u003e\u003cbr\u003eStand out from the other players, choose a skin from the wardrobe, or create your own unique style. The further you go, the more skins you unlock. \u003cbr\u003e\u003cbr\u003eWorms Zone is also a PVP action game! Watch out for other players and try not to bump into them, otherwise you’ll have to start from scratch. However, if you manage to sneak and encircle them, you’ll get more points and all the food they had. It is so yummy! \u003cbr\u003e\u003cbr\u003eThere are several tactics for becoming a champion: “fighter”, “trickster” or “builder”. Which one will you be?  \u003cbr\u003eWorms Zone also has unique graphics! We keep it minimalistic and simple and you\u0026#39;ll love it! \u003cbr\u003e\u003cbr\u003e\u003cbr\u003eWe are happy when our players are happy, so if you have any thoughts, complaints, or cool ideas - feel free to share them and contact us at support@wildspike.com. \u003cbr\u003e\u003cbr\u003eJoin our community! Follow our official Facebook page to get all the latest news and updates: https://www.facebook.com/wormszone/ \u003cbr\u003e\u003cbr\u003eStart growing your worm now! Slither into this crazy arcade and enjoy!"],"CASUAL AZUR GAMES","500,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/kWUsGydYiCprppoRenHX0YF5VdMg9IPfxhJvSxsmxhjnZeGgCo6waUPLgjUcHG4AzqoZy4frtJhWbfo0St0KGg"],null,[7,8,10,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,[null,"In-Game 