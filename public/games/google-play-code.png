,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/NWdankPzVWV6ubLam60ENIhH1aOdSkZnjwV6bXTHv4oqSCBPff7HHYaJPOOwqjXilK8GNVeqgYrrQBLuov69yg"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/GutzGr0BVWzmT4kwQs2oKdzzbo0WrA_FGwSiO96ftsznAdTqswAZaODgrr4MzTJUkO4sh4cSbrCkfET-1VBcfA"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/E0jgN8GEGHWbWO5aa0tAoqSzjM6Ju7isXOZZqOlIeIpZwu87L3Wxf3OmZt_b6mIHkRGe39Yv2GIdrCLDUjS5uQ"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/NHm4wkY53B4mkSB9mvkBSjTdbf5g_jaMN92jW-UaE-V1Dqek6H9p98-447_QOC2DkD6YEUAILeqwEH5PGy3e"]]],"Kalliu Game World: Life Story",["4.7",4.7088575],"Puzzle",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.sinyee.babybus.gameworld.design.home.friends.fun.life.story\u0026rdid\u003dcom.sinyee.babybus.gameworld.design.home.friends.fun.life.story\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.sinyee.babybus.gameworld.design.home.friends.fun.life.story"]],["\u003d\u003d"],[[[null,null,"owNqclwtAuk",[null,null,"https://www.youtube.com/embed/owNqclwtAuk?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:owNqclwtAuk",null,null,null,null,"AXH1ezn4MXUJ4GZJNwGNUYTugddN1aqwluP2HwZf1Jp9b3_YJW4qUeJtRIVipAjorBFvLfn2yFmofDHg8Dru8wr2N7xSTR4aGzQzQ4oNKqDyy5rY_lKWDnbiWWhXQhzaGl0DYG1wdjM-w-lRuYEUihUkorUqCn7EOQEOE8ZTKjgcI6tr0stl0DgmE8NE2q8fSd28frLgSjVJvM1bToZo659rSoeBV45-PKAdLAPB2jzOruBVzOQ3UQ6SDsTlYmpR0LaU_pBTHM2KZIKceFdqJdjqEolktZS5FVucwsU2pVH0PdU\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/owNqclwtAuk/hqdefault.jpg"]]]],[null,"Bigger! Freer! Wilder!\u003cbr\u003eSecrets to unlock. Adventures to conquer.\u003cbr\u003eThis is only the first chapter of Kalliu Game World.\u003cbr\u003eA greater Kalliu World is on the way.\u003cbr\u003eAre you ready to step in? \u003cbr\u003e\u003cbr\u003eIn this fully open world, you can create characters, design houses, explore every location, and unlock hidden surprises. Build, discover, upgrade—this is your world. \u003cbr\u003e\u003cbr\u003eCREATE UNLIMITED CHARACTERS\u003cbr\u003eBecome a doctor, a designer, a celebrity… or anyone you want! Create endless characters and style their hair, outfits, expressions, and actions. Change identities anytime and rewrite the story whenever you feel like it.\u003cbr\u003eNo rules. No limits. Just your imagination.\u003cbr\u003e\u003cbr\u003eBUILD AND DESIGN YOUR DREAM HOME\u003cbr\u003ePrincess house? Modern loft? Seaside villa? Just get creative! With the powerful home design system, you can build the house you want, upgrade furniture, and redesign layouts. Keep exploring to discover rare items and hidden decorations to upgrade your home.\u003cbr\u003eThe more you explore, the more surprises you\u0026#39;ll find.\u003cbr\u003e\u003cbr\u003eEXPLORE AND DISCOVER SECRETS\u003cbr\u003eFrom the school and hospital to the shopping mall, beauty salon, sunny beach, and pink villa, every location is open to explore. Look closely and you might find hidden coins, unlock secret rooms, or trigger surprise events… Start your own treasure hunt.\u003cbr\u003eEvery exploration reveals a new secret.\u003cbr\u003e\u003cbr\u003eUNLOCK HOLIDAY EVENTS AND SPECIAL GIFTS\u003cbr\u003eDon\u0026#39;t forget to watch for our anniversary and seasonal events! Lots of gifts will be waiting for you, including coins, furniture, outfits, pets, and more. Also keep an eye on special in-game quests. Complete the challenges to unlock exclusive gifts and extra rewards!\u003cbr\u003eYou never know when the next surprise will appear!\u003cbr\u003e\u003cbr\u003eHERE, YOU\u0026#39;LL HAVE ENDLESS POSSIBILITIES!\u003cbr\u003eJump into new adventures through role-playing. Explore freely and expand your world. Take on challenges and upgrade your items. Come experience it now!\u003cbr\u003e\u003cbr\u003eFEATURES:\u003cbr\u003e- A fully open world to explore;\u003cbr\u003e- Secrets, rooms, and coin hunts;\u003cbr\u003e- Unlimited characters to create;\u003cbr\u003e- Advanced home design system;\u003cbr\u003e- Holiday events and special gifts;\u003cbr\u003e- Free exploration across the entire world;\u003cbr\u003e- New location(s) updated every week;\u003cbr\u003e- Day and night cycle with weather system;\u003cbr\u003e- Safe and friendly game environment;\u003cbr\u003e- Play offline anytime, anywhere."],"Joltrix","50,000,000+",null,"Ages up to 12",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/M5V4atxQ2qYCmqiJXixONKiX7pilg3EIrCaYZjoULmyeSYte9MpWOwdmA9s1sP2GmfkkeibentgQHkn0ZdUWvA"],null,[135,244,254,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,[null,"In-Game Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.sinyee.babybus.gameworld.design.home.friends.fun.life.story\u0026rdid\u003dcom.sinyee.babybus.gameworld.design.home.friends.fun.life.story\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 9.000 - Rp 199.000 per item",[0]],{"101":[null,[[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/asoivH3WbHtLe