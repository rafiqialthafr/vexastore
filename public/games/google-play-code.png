ngdom",["4.3",4.3023925],"Strategy",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.star.union.planetant\u0026rdid\u003dcom.star.union.planetant\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.star.union.planetant"]],["\u003d\u003d"],[[[null,null,"_4W7lTmcLO0",[null,null,"https://www.youtube.com/embed/_4W7lTmcLO0?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:_4W7lTmcLO0",null,null,null,null,"AXH1ezm6ihdepMwFeoK4tVMttxur06h1MZUAn0W_5cyGRi6wPnFr0wAUkI5BpNB-AlW6v6FDCRf0hAyT8rh6P-E5jkQgHFmZEraV6k1d60CXgScpJqGKZpETXz9sK8FV3pSHD9OOmH3xTJoDCJQsotQGubcGc8LJH2ytzubessCyOBA2rG77rvg4Ilk4tdYWCK4eeeEcQWzywFmbF1OPrnxFQdU6l5JrxcUucPVLatvTfVe6UtIe_d4QanplLFJRsHByPuKTmxtMSioxZgGMDrNQnPTHkQ6pc2IuhufoICqrJvM\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/_4W7lTmcLO0/hqdefault.jpg"]]]],[null,"On a hopeful morning, a queen ant finally found a haven where she would build her anthill. Yet, in this survival-of-the-fittest world, dangers lurk everywhere. As the ruler, you will guide the ant colony to overcome harsh environments, formulate various survival strategies, and rebuild a prosperous ant kingdom.\u003cbr\u003e\u003cbr\u003e[Survival Above All]\u003cbr\u003eCrisis is upon us, and the ant colony faces the threat of extinction. We must secure enough resources to survive in this perilous world. As the Ruler, your top priority is to construct the anthill, protect the queen, and fend off looming dangers.\u003cbr\u003e[Rebuild Our Anthill]\u003cbr\u003eSurviving is only the first step. The anthill must be expanded. The ant tunnels are the critical connections among different anthills.\u003cbr\u003eStrategic planning of locations is vital for the development of the anthill. Now is the time to show your wisdom!\u003cbr\u003e[Seek Powerful Special Ants]\u003cbr\u003eHatch mutated eggs to obtain powerful special ants and boost your combat power. The more special ants you hatch, the more control you will have in the ant kingdom, ensuring a safer survival.\u003cbr\u003e[Tame Dangerous Insects]\u003cbr\u003eThis land is inhabited by other dangerous but powerful insects. Tame them and bring them into battle, or have them work inside the anthill to speed up its development.\u003cbr\u003e[Build a Strong Alliance]\u003cbr\u003eDon\u0026#39;t let your ant colony face invaders alone. Create or join an alliance, support each other, and dominate the battlefield together. Rule the ant kingdom with your allies!\u003cbr\u003e[Conquer the Tree of Abundance \u0026amp; Vanquish Your Enemies]\u003cbr\u003eFight alongside your allies to seize the Squirters and claim the Tree of Abundance, and you will become the King of the entire realm. Reward your allies, punish your enemies, and let your legend spread across the ant kingdom.\u003cbr\u003e\u003cbr\u003eThe Ants: Underground Kingdom provides an instant online customer service, which will surely give you a better gaming experience. No matter what kind of questions you have, we are here to help as much as possible. You can contact us through the following channels:\u003cbr\u003e◆Official LINE: @theantsgame (don\u0026#39;t forget \u0026quot;@\u0026quot;)\u003cbr\u003e◆Official Discord: https://discord.gg/PazRBH8kCC\u003cbr\u003e◆Official Facebook: https://www.facebook.com/TheAntsGame\u003cbr\u003e◆Official Support E-mail: theants@staruniongame.com\u003cbr\u003e◆Official TikTok: @theants_global\u003cbr\u003e◆Official website: https://theants.allstarunion.com/\u003cbr\u003e\u003cbr\u003eAttention!\u003cbr\u003eThe Ants: Underground Kingdom is free to download. However, some items in the game are not free. Players must be at least 3 years old to download it, as defined in the Terms of Use and Privacy Policy. Besides, devices should have access to network as this is an online game."],"StarUnion","50,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/JyY9HW9KVIWav1SBS364UG492dgbeH2HAKOg9RymwTc5l5texEJTdcJbaiJ91kJefy6B8HB9nF70NMTV7rW-7g"],null,[18,14,6,255]],null,["Rated for 16+",[null,2,[366,512],[null,null,"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt"]],[null,"Mild Violence"],[null,"Users Interact, In-Game Purchases, In-Game Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.star.union.planetant\u0026rdid\u003dcom.star.union.planetant\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 5.000 - Rp 1.689.000 per item",[0]],{"101":[null,[[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/dgOk4mycw-hVqIKXgv8Qd3xpFZzS-X9uDAiF9LLgkrwOXsONab-mm--VnG2JLzUstlTpFfNEgBJifFhXzqRK"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/bj6D80-QaL2X_rueYlsOf5ZHPq-I50f1DaAybfmWjPJ83VuM4chTDoGkxHXCzT_we8LdpopC-ITzEp6l4k_c"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/becHXeB6y6GB9sg8iuiSWmAIAAjlMgPDEvPJsUBOP1hi4VvbGBG2gHLC91l9uQ0OUj7LLGKoFJ0_ym4_-K0_"]],[null,2,[1242,2208],[null,null,"https://play-lh.googleusercontent.com/KLrpiSo1twrch05NAsSvi3t25MurUJK6N7TsTRZXWwWZ7HpyVsimBDErLyX0q0zfYoENVEdDtzkT0Nh9MnVN"]],[null,2,[1242,2208],[null,nu