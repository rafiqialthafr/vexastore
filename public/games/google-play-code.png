l2WjNeFkMODrF3MaWkpBkyjEibNK8eEsQaKk9YFUWpQl4rw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/3xKEmeWjzGe5oEP79blAnYFIrmBF7JjrR1JuRHtlPsrRxPl8kBoxCJOrNoUSxthQIWaboZzn8n249WZhslFA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/QhoeGqUZzvCy5mvLmsebALM_yFG3CyfWtCL8J0uq7wunxbAzTO3ZjT7X3fNSBGvxfX6uGrct_GT2qzZoVUbu6Ik"]]],"9 Kings",["4.5",4.457143],"Strategy",null,null,[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.playdigious.ninekings\u0026rdid\u003dcom.playdigious.ninekings\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.playdigious.ninekings"]],[""],[[[null,null,"-2c8bCryKlQ",[null,null,"https://www.youtube.com/embed/-2c8bCryKlQ?vq\u003dlarge\u0026rel\u003d0\u0026autohide\u003d1\u0026showinfo\u003d0"],"yt:movie:-2c8bCryKlQ",null,null,null,null,"AXH1ezlakIW1sh_4-QdjYXmVkFxVXrPMs8QQ2aXKPRdGHobFddMo4UWdNc1Tpzlh0Y0IKgq6l0yJWs4sDt-AfMuMUdXcBUEhfAx1nrR07k4rZtZxUQno4LCt_IhfJPFTMIncwHNpEb4Novqss0iZRTlhii50vH40X7v3kMQLlmjaTRZbwTliG_usz5m25LEH5st8NEVQT6bftxxEee1hxRyt_wfOvTpDMtDsxy1U4pfv6CLF17KLe2tLp4aAX8UhNVeVPArbIK7obf2bhx5GZhRSPEEfMs6Y64ZI6xMMulj3_k8\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/-2c8bCryKlQ/hqdefault.jpg"]]]],[null,"*Try 9 Kings for free and buy the full game to unlock all Kings, new quests, multiplayer and more!*\u003cbr\u003e\u003cbr\u003eGrow your empire, craft your deck, fight massive battles and break the game with insane builds to become the King of Kings in this fast-paced roguelike kingdom builder\u003cbr\u003e\u003cbr\u003eFEATURES:\u003cbr\u003e\u003cbr\u003e-Play as one of nine kings, each with their own playstyle: stockpile gold to hire mercenaries, harness the forces of nature, warp the laws of time, dabble in dark magic or raise hordes of fiendish imps ready to fight for you\u003cbr\u003e\u003cbr\u003e-Grow your citadel as you strategically place your cards to expand your territory, upgrade buildings and towers, recruit new troops and boost them by stacking effects and spells\u003cbr\u003e\u003cbr\u003e-Craft your deck carefully by looting rival kings to combine their unique cards with yours and create new powerful synergies\u003cbr\u003e\u003cbr\u003e-Protect your kingdom as long as you can against increasingly powerful enemies and attempt to break the game with insane builds as you endure decades of war, strife and unpredictable events\u003cbr\u003e\u003cbr\u003e-Enjoy endless replayability in this roguelike autobattler: every run is different, mastery comes from experimentation and new ground can be conquered through unique challenges in Quest Mode\u003cbr\u003e\u003cbr\u003e-Climb the ranks, customize your look and prove yourself to truly be the king of kings as you battle eight rivals in async multiplayer\u003cbr\u003e\u003cbr\u003eCAREFULLY REDESIGNED FOR MOBILE\u003cbr\u003eRevamped interface – exclusive mobile UI with complete touch control\u003cbr\u003eGoogle Play Games achievements\u003cbr\u003eBuy once, play anywhere: Enjoy cross-progression on mobile and PC with the same Google Play Games account\u003cbr\u003eCloud Save – Share your progress between Android devices"],"Playdigious","500,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/kmHEEUOtva8nUWqk1fiIUugR1XM26Gdz_eQv3htS5e4HfDvSdR9jlZ7glfBr3NwQVDciBnCR3H4B8yEjLn2v"],null,[49,50,52,255]],null,["Rated for 3+",[null,2,[487,512],[null,null,"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ"]],null,null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],1,[null,"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted."],[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"IDR",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.playdigious.ninekings\u0026rdid\u003dcom.playdigious.ninekings\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["Rp 99.000 per item",[0]],{"101":[null,[[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/tvgrV7rjLGZ-GdnOw7bghegS_QleZMcAk7ortbom5zOwj-HNzFnVAUoJcmPxKGsO86m1YGkOdVBHgs-GVITxkQ"]],[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/X47xoOvaUugfAEUpAviTNh5-bRaQeKRUo_NhwVsrr1h3jEHD1uipQevT-ADVolzUc9DDTQk1W0hB5YyG9VN7Wgc"]],[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/xAyLie6PmWajV3ZUU_xB4YYj5DzJHqu5bkQKmpE42uxAq8_wcn_8fRDCtfBm8bTpevE_XIkmH9U7wE9BLj0"]],[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/HGcBrJgaWeGsvbFYEQJGhKPDCrOlXtMvjc-SsNKiW5fLmwRBGK7EJAlXakAlnTFq2r7Spuez1vlZVMpwxGXHuHc"]],[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/7gcS8kt_NinjjnddiBaz6UX3nrZjcVK81Sw7akIfS3QUyxONE0BB2vCgojdmozxglbUXsSdXkJa2c3SoWRjVlA"]],[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/QkHIKE5orH7liuvj02mvT6UO2XfRKlLIPiroeoHp2I7vvdomAGJsULX67wzen_48Un5t7rnmBenYcKa1R0Il"]],[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/JUV9IQRq7oRhK5JY_BQ69hWiyc4-wQIX-H3HGpD32V6mV0oNBkt8KssmlqbUw6aHwnrINXftzEx6ZQBZ8-2m"]],[null,2,[1290,2796],[null,null,"https://play-lh.googleusercontent.com/LUvwWYLlqO5D1Mx9Fhz8JvraRmdrdio2KcRTpvWeXwd6Y7WTAIBEUnT48x_ow0R9MEMjaphgMB9PswTYZMjGeQ"]],[null,2,[2048,2732],[null,null,"https://play-lh.googleusercon